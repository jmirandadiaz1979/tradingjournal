  function computeRMetrics(trades){
    const withR = trades.filter(t=>t.rMultiple!=null);
    if(!withR.length) return null;
    const n = withR.length;
    const netR = withR.reduce((s,t)=>s+t.rMultiple,0);
    const winsR = withR.filter(t=>t.rMultiple>0), lossesR = withR.filter(t=>t.rMultiple<0);
    const avgWinR = winsR.length ? winsR.reduce((s,t)=>s+t.rMultiple,0)/winsR.length : 0;
    const avgLossR = lossesR.length ? lossesR.reduce((s,t)=>s+t.rMultiple,0)/lossesR.length : 0;
    const longs = withR.filter(t=>t.side==='Long'), shorts = withR.filter(t=>t.side==='Short');
    const longR = longs.reduce((s,t)=>s+t.rMultiple,0), shortR = shorts.reduce((s,t)=>s+t.rMultiple,0);
    return {n, netR, avgR: netR/n, avgWinR, avgLossR, longR, shortR};
  }
