  .insight i{flex:none;width:9px;height:9px;border-radius:50%;margin-top:6px;background:var(--blue);}
  .insight.pos i{background:var(--green);} .insight.neg i{background:var(--red);} .insight.warn i{background:var(--yellow);}
  .insight b{color:#fff;}

  /* cuentas de fondeo */
  .funded-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(310px,1fr));gap:12px;}
  .fund-card{background:var(--panel-2);border:1px solid var(--border);border-radius:12px;padding:14px 16px;}
  .fund-card .fc-head{display:flex;justify-content:space-between;align-items:center;gap:10px;margin-bottom:10px;}
  .fund-card .fc-name{font-weight:700;font-size:13.5px;color:#fff;word-break:break-all;}
  .fund-card .fc-row{margin-top:12px;}
  .fund-card .fc-top{display:flex;justify-content:space-between;font-size:12px;color:var(--text-dim);margin-bottom:5px;gap:10px;}
  .fund-card .fc-top b{color:#fff;font-weight:600;}
  .pb{height:8px;border-radius:5px;background:#1c2940;overflow:hidden;position:relative;}
  .pb>span{display:block;height:100%;border-radius:5px;background:var(--green);}
  .pb.warn>span{background:var(--yellow);} .pb.bad>span{background:var(--red);} .pb.blue>span{background:var(--blue);}
  .pb .mark{position:absolute;top:-2px;bottom:-2px;width:2px;background:#fff;opacity:.8;}
  .fund-note{font-size:11.5px;color:var(--text-faint);margin-top:10px;line-height:1.5;}
  .fund-cfg input{width:110px;}

  /* alpha */
  .alpha-total{display:flex;align-items:baseline;gap:8px;margin:2px 0 6px;color:var(--text-dim);font-size:12px;}
  .alpha-total b{font-size:26px;color:#fff;letter-spacing:-.02em;}

  /* calendario: 7 días + columna de semana */
  .cal-grid{grid-template-columns:repeat(7,minmax(0,1fr)) minmax(74px,.85fr);}
  .cal-cell.week{background:rgba(255,255,255,.04);border-style:dashed;}
  .cal-cell.week .d{color:var(--text-dim);}
  .cal-cell .cnt{font-size:10px;color:var(--text-dim);margin-top:2px;}
  .cal-day-label.wk{color:var(--text);}

  /* modal de operación: navegación */
  .tm-nav{display:flex;align-items:center;gap:8px;margin:0 30px 10px 0;font-size:12px;color:var(--text-dim);}
  .tm-nav button{padding:4px 10px;}
  .tm-nav #tmNavInfo{min-width:60px;text-align:center;color:#fff;font-weight:600;}
  .tm-keys{font-size:11.5px;color:var(--text-faint);margin-top:10px;display:none;}
  .tm-keys kbd{background:var(--panel-2);border:1px solid var(--border);border-radius:5px;padding:1px 6px;font-size:11px;color:#fff;}

  @media (max-width:768px){
    .topbar{position:static;margin:0 0 12px;padding:8px 0;background:transparent;border:none;backdrop-filter:none;}
    .cal-grid{grid-template-columns:repeat(7,minmax(0,1fr)) 54px;}
    .cal-cell .cnt{display:none;}
  }

  /* impresión del informe semanal */
  @media print{
    :root{--bg:#fff;--panel:#fff;--panel-2:#f4f6f9;--panel-3:#fff;--border:#c9d1dc;--text:#101828;--text-dim:#344054;--text-faint:#475467;--green:#067647;--red:#b42318;--purple:#5b3fd0;}
    body{background:#fff !important;color:#101828;}
    .sidebar,.mobile-menu-btn,.sidebar-overlay,.topbar,.sync-banner,#toast,#chartTooltip,.cal-nav,.modal-overlay{display:none !important;}
    .main-area{padding:0 !important;max-width:100%;}
    .view{display:none !important;} .view.active{display:block !important;}
    .panel,.card{background:#fff !important;box-shadow:none !important;border-color:#c9d1dc !important;break-inside:avoid;}
    .row2,.row3{grid-template-columns:1fr 1fr !important;}
    td,th{color:#101828 !important;background:#fff !important;}
    .pos{color:#067647 !important;} .neg{color:#b42318 !important;}
    .wk-line,.wk-line b{color:#101828 !important;}
    .badge{background:#eef1f5 !important;color:#101828 !important;}
    .page-title{color:#101828;}
  }
</style>
</head>
