  const RULE_FIELDS = [['rlS1Start','s1Start'],['rlS1End','s1End'],['rlS2Start','s2Start'],['rlS2End','s2End'],['rlMaxLoss','maxLoss'],['rlMaxOps','maxOps'],['rlMaxSL','maxSL']];
