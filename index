  // aplica el playbook (setups, tags, notas, riesgo, stop/target...) guardado en tradeMeta a un trade ya construido
  function attachMeta(t){
    const meta = tradeMeta[t.id] || findAltMeta(t) || {};
    t.setups = meta.setups || (meta.setup ? [meta.setup] : []); // compat con datos antiguos (un solo setup)
