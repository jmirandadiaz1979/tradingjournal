  .gauge.lv2 .g-fill{background:var(--red);}
  .gauge.lv2{border-color:rgba(239,91,110,.45);}
  .today-msg{margin-top:14px;padding:10px 14px;border-radius:9px;border:1px solid;font-size:13px;line-height:1.5;}
  .today-msg.st-stop{font-weight:700;font-size:14px;}
  .today-foot{margin-top:10px;font-size:12px;color:var(--text-faint);}
  /* ---------- checklist, comisiones, sync ---------- */
  .chk-box{background:var(--panel-2);border:1px solid var(--border);border-radius:10px;padding:10px 12px;}
  .chk-grp + .chk-grp{margin-top:10px;}
  .chk-title{font-size:12px;font-weight:600;color:var(--text);margin-bottom:4px;}
  .field label.chk-line, label.chk-line{display:flex;gap:8px;align-items:flex-start;text-transform:none;letter-spacing:0;font-size:13px;color:var(--text-dim);margin:0;padding:4px 0;cursor:pointer;}
  .field label.chk-line input, label.chk-line input{width:auto;margin-top:2px;accent-color:var(--purple);flex:none;}
  .chk-sum{margin-top:8px;font-size:12px;color:var(--text-faint);}
  .comm-input{width:100px;}
  .sync-banner{display:none;align-items:center;gap:12px;flex-wrap:wrap;margin-bottom:14px;padding:11px 16px;border-radius:10px;border:1px solid rgba(224,177,58,.4);background:rgba(224,177,58,.09);color:var(--text);font-size:13px;}
