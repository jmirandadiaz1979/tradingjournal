  }, 60000);

  // ---------- checklist por operación ----------
  function setupChecklist(name){
    const st = setupsList.find(function(s){ return s.name===name; });
    return (st && st.checklist) ? st.checklist : [];
  }
  function checklistStats(setups, checks){
    let total = 0, done = 0;
    (setups||[]).forEach(function(n){
      const items = setupChecklist(n); total += items.length;
      const marked = (checks && checks[n]) || [];
      items.forEach(function(it){ if(marked.indexOf(it)>=0) done++; });
    });
    return {total:total, done:done, pct: total ? Math.round(done/total*100) : null};
  }
  function cloneChecks(c){ const o = {}; Object.keys(c||{}).forEach(function(k){ o[k] = (c[k]||[]).slice(); }); return o; }
  function cleanChecks(setups, checks){
    const o = {};
    (setups||[]).forEach(function(n){
      const items = setupChecklist(n);
      const m = ((checks && checks[n])||[]).filter(function(x){ return items.indexOf(x)>=0; });
      if(m.length) o[n] = m;
    });
    return o;
  }
  function bindChecklist(boxId, getSetups, checks){
    const box = document.getElementById(boxId);
    const setups = getSetups();
    const withItems = setups.filter(function(n){ return setupChecklist(n).length; });
    if(!setups.length){ box.innerHTML = '<div class="sub-hint" style="margin:0;">Elige uno o varios setups para ver su checklist.</div>'; return; }
    if(!withItems.length){ box.innerHTML = '<div class="sub-hint" style="margin:0;">Los setups elegidos no tienen checklist. Añádelo en «Setups &amp; Tags» para medir tu cumplimiento.</div>'; return; }
    box.innerHTML = withItems.map(function(n){
      const marked = checks[n] || [];
      return '<div class="chk-grp"><div class="chk-title">'+h(n)+'</div>'+
        setupChecklist(n).map(function(it,i){
          return '<label class="chk-line"><input type="checkbox" data-s="'+esc(n)+'" data-i="'+i+'"'+(marked.indexOf(it)>=0?' checked':'')+'><span>'+h(it)+'</span></label>';
        }).join('')+'</div>';
    }).join('')+'<div class="chk-sum"></div>';
    function sum(){
      const st = checklistStats(getSetups(), checks);
      box.querySelector('.chk-sum').textContent = 'Cumplido: '+st.done+' de '+st.total+(st.pct!=null ? ' · '+st.pct+'%' : '');
    }
    sum();
    box.querySelectorAll('input[type=checkbox]').forEach(function(cb){
      cb.addEventListener('change', function(){
        const n = cb.dataset.s, item = setupChecklist(n)[Number(cb.dataset.i)];
        const arr = checks[n] = checks[n] || [];
        const idx = arr.indexOf(item);
        if(cb.checked && idx<0) arr.push(item);
        if(!cb.checked && idx>=0) arr.splice(idx,1);
        sum();
      });
    });
  }
  function renderTmChecklist(){ bindChecklist('tmChecklist', function(){ return tmSelectedSetups; }, tmChecks); }
  function renderMmChecklist(){ bindChecklist('mmChecklist', function(){ return mmSelectedSetups; }, mmChecks); }
  function checklistChip(t){
    if(t.chkPct==null) return '—';
    return '<span class="badge '+(t.chkPct>=100?'detected':(t.chkPct>=50?'warn':'bad'))+'" title="'+t.chkDone+' de '+t.chkTotal+'">'+t.chkPct+'%</span>';
  }
  function exitChip(t){
    if(!t.exitType) return '—';
    return '<span class="badge'+(t.exitType==='SL'?' bad':(t.exitType==='TP'?' detected':''))+'">'+(EXIT_LABEL[t.exitType]||h(t.exitType))+'</span>';
  }

  // ---------- pendientes de completar / calidad de datos ----------
  const MISS_LABEL = {setup:'Setup', emotion:'Emoción', plan:'Plan', exit:'Salida'};
  function missingFields(t){
    const m = [];
    if(!(t.setups && t.setups.length)) m.push('setup');
    if(!t.emotion) m.push('emotion');
    if(!t.planFollowed) m.push('plan');
    if(!t.exitType) m.push('exit');
    return m;
  }
  function pendingList(trades, filt){
    const core = function(t){ return missingFields(t).filter(function(k){ return k!=='exit'; }); };
    return trades.filter(function(t){ return filt ? missingFields(t).indexOf(filt)>=0 : core(t).length>0; })
      .sort(function(a,b){ return b.closeTime-a.closeTime; });
  }
  function renderQuality(trades){
    const filt = document.getElementById('pendFilter').value;
    const core = function(t){ return missingFields(t).filter(function(k){ return k!=='exit'; }); };
    const total = trades.length;
    const complete = trades.filter(function(t){ return core(t).length===0; }).length;
    const cnt = function(k){ return trades.filter(function(t){ return missingFields(t).indexOf(k)>=0; }).length; };
    const pct = total ? Math.round(complete/total*100) : 0;
    document.getElementById('qualityKpis').innerHTML =
      '<div class="m"><b class="'+(pct>=90?'pos':(pct>=60?'':'neg'))+'">'+pct+'%</b>datos completos · '+complete+' de '+total+'</div>'+
      '<div class="m"><b>'+cnt('setup')+'</b>sin setup</div>'+
      '<div class="m"><b>'+cnt('emotion')+'</b>sin emoción</div>'+
      '<div class="m"><b>'+cnt('plan')+'</b>sin plan</div>'+
      '<div class="m"><b>'+cnt('exit')+'</b>sin tipo de salida</div>';
    const list = pendingList(trades, filt);
    const shown = list.slice(0, 50);
    document.querySelector('#pendTable tbody').innerHTML = shown.length
      ? shown.map(function(t){
          const miss = filt ? missingFields(t) : core(t);
          return '<tr class="trade-row" data-id="'+esc(t.id)+'"><td>'+new Date(t.closeTime).toLocaleString('es-ES')+'</td><td>'+h(t.contract)+' '+h(t.side)+'</td>'+
            '<td class="'+pnlCls(t.pnl)+'">'+fmtMoney(t.pnl)+'</td><td>'+miss.map(function(k){ return '<span class="badge warn">'+MISS_LABEL[k]+'</span>'; }).join(' ')+'</td></tr>';
        }).join('')
      : '<tr><td colspan="4" class="sub-hint">Nada pendiente con este filtro.</td></tr>';
    document.querySelectorAll('#pendTable tr.trade-row').forEach(function(tr){
      tr.addEventListener('click', function(){ openTradeModal(tr.dataset.id, {ids:shown.map(function(t){ return t.id; })}); });
    });
    document.getElementById('pendNote').textContent = list.length>50 ? 'Mostrando las 50 más recientes de '+list.length+'.' : (list.length ? list.length+' operaciones por completar. Haz clic en una fila para rellenarla.' : '');
  }
  document.getElementById('pendFilter').addEventListener('change', function(){ renderQuality(currentFilteredTrades()); });

  // ---------- comisiones ----------
  function renderCommissions(){
    const body = document.getElementById('commBody'); if(!body) return;
    if(body.contains(document.activeElement)) return; // no pisar lo que se está escribiendo
    const prods = new Set(['MNQ','MES','NQ','ES']);
    allTrades.forEach(function(t){ if(t.product) prods.add(t.product); });
    Object.keys(commissions).forEach(function(p){ prods.add(p); });
    body.innerHTML = Array.from(prods).sort().map(function(p){
      const list = allTrades.filter(function(t){ return t.product===p; });
      const paid = list.reduce(function(s,t){ return s+(t.commissionPaid||0); },0);
      return '<tr><td>'+h(p)+'</td><td><input type="number" class="comm-input" data-p="'+esc(p)+'" step="0.01" min="0" placeholder="0.00" value="'+(commissions[p]!=null?commissions[p]:'')+'"></td>'+
        '<td>'+list.length+'</td><td>'+(paid ? fmtMoneyPlain(paid) : '—')+'</td></tr>';
    }).join('');
  }
  document.getElementById('commSave').addEventListener('click', function(){
    const next = {}; let bad = false;
    document.querySelectorAll('#commBody .comm-input').forEach(function(inp){
      const v = inp.value.trim(); if(v==='') return;
      const n = parseFloat(v);
      if(isNaN(n) || n<0){ bad = true; return; }
      if(n>0) next[inp.dataset.p] = n;
    });
    if(bad){ toast('Revisa las comisiones: hay un valor inválido.'); return; }
    commissions = next;
    process();
    toast('Comisiones guardadas. El P&L neto se ha recalculado.');
  });
  function updateCommUI(){
    const prod = productFromSymbol(String(document.getElementById('mtContract').value).trim().toUpperCase());
    const rate = commissions[prod] || 0;
    const qty = parseFloat(document.getElementById('mtQty').value) || 0;
    const pnl = parseFloat(document.getElementById('mtPnl').value);
    const on = document.getElementById('mtDeductComm').checked;
    document.getElementById('mtCommLabel').textContent = rate>0
      ? 'Descontar comisión ('+prod+' · '+fmtMoneyPlain(rate)+' por contrato)'
      : 'Descontar comisión (sin tarifa para '+(prod||'este contrato')+' en Ajustes)';
    let txt = '';
    if(on && rate>0 && !isNaN(pnl)) txt = 'Comisión '+fmtMoneyPlain(rate*qty)+' · P&L neto '+fmtMoney(pnl-rate*qty);
    else if(!on) txt = 'Se guarda el P&L tal como lo escribes.';
    document.getElementById('mtNetPreview').textContent = txt;
  }
  ['mtContract','mtQty','mtPnl'].forEach(function(id){ document.getElementById(id).addEventListener('input', updateCommUI); });
  document.getElementById('mtDeductComm').addEventListener('change', updateCommUI);

  // ---------- estadísticas nuevas ----------
  function renderStatsPlus(trades){
    renderMonthCompare(accountTrades());
    renderHourWindow(trades);
    // checklist
    const buckets = [
      ['100% (A+)', function(t){ return t.chkPct===100; }],
      ['75–99%', function(t){ return t.chkPct!=null && t.chkPct>=75 && t.chkPct<100; }],
      ['50–74%', function(t){ return t.chkPct!=null && t.chkPct>=50 && t.chkPct<75; }],
      ['Menos de 50%', function(t){ return t.chkPct!=null && t.chkPct<50; }],
      ['Sin checklist', function(t){ return t.chkPct==null; }]
    ];
    fillStatTable('checklistTable', buckets.map(function(b){ return {name:b[0], list:trades.filter(b[1])}; }), 'Sin datos.', false);
    const full = trades.filter(function(t){ return t.chkPct===100; }), part = trades.filter(function(t){ return t.chkPct!=null && t.chkPct<100; });
    const insEl = document.getElementById('chkInsight');
    if(full.length>=3 && part.length>=3){
      const a = computeMetrics(full), b = computeMetrics(part);
      insEl.textContent = 'Con el checklist completo: '+fmtMoney(a.expectancy)+' por operación ('+a.n+' ops). Con el checklist incompleto: '+fmtMoney(b.expectancy)+' por operación ('+b.n+' ops).';
    } else {
      insEl.textContent = 'Necesitas al menos 3 operaciones con checklist completo y 3 con checklist incompleto para comparar. Añade reglas a tus setups y márcalas al registrar.';
    }
    // tipo de salida
    const eg = groupBy(trades, function(t){ return t.exitType || 'x'; });
    fillStatTable('exitTable', EXIT_TYPES.map(function(e){ return {name:e[1], list:eg[e[0]]||[]}; }).concat([{name:'Sin registrar', list:eg.x||[]}]), 'Sin datos.', false);
    const cap = trades.filter(function(t){ return t.tpCapture!=null; });
    const capEl = document.getElementById('tpCaptureStats');
    if(cap.length){
      const avg = function(l){ return l.reduce(function(s,t){ return s+t.tpCapture; },0)/l.length; };
      const wins = cap.filter(function(t){ return t.pnl>0; });
      capEl.innerHTML =
        '<div class="m"><b>'+Math.round(avg(cap)*100)+'%</b>recorrido medio hacia el TP · '+cap.length+' ops</div>'+
        '<div class="m"><b>'+(wins.length ? Math.round(avg(wins)*100)+'%' : '—')+'</b>en ganadoras · '+wins.length+' ops</div>';
    } else {
      capEl.innerHTML = '<div class="sub-hint" style="margin:0;">Para medir el recorrido necesitas operaciones con TP y precio de salida.</div>';
    }
  }
  function monthBucket(trades, y, m){
    const list = trades.filter(function(t){ const d = new Date(t.closeTime); return d.getFullYear()===y && d.getMonth()===m; });
    const days = (ruleEval ? ruleEval.days : []).filter(function(d){ const x = new Date(d.date); return x.getFullYear()===y && x.getMonth()===m; });
    return {list:list, m:computeMetrics(list), days:days.length, clean:days.filter(function(d){ return d.clean; }).length};
  }
  function renderMonthCompare(trades){
    const now = new Date();
    const cur = monthBucket(trades, now.getFullYear(), now.getMonth());
    const pd = new Date(now.getFullYear(), now.getMonth()-1, 1);
    const prev = monthBucket(trades, pd.getFullYear(), pd.getMonth());
    const cap = function(s){ return s.charAt(0).toUpperCase()+s.slice(1); };
    const lblCur = cap(now.toLocaleDateString('es-ES',{month:'long',year:'numeric'})), lblPrev = cap(pd.toLocaleDateString('es-ES',{month:'long',year:'numeric'}));
    document.getElementById('mcCur').textContent = lblCur;
    document.getElementById('mcPrev').textContent = lblPrev;
    document.getElementById('monthCmpHint').textContent = lblCur+' llega hasta hoy; '+lblPrev+' está completo, así que los totales (P&L, operaciones, días) no son comparables 1 a 1: fíjate en win rate, profit factor y expectancy.';
    function row(label, cv, pv, fmt, kind, better){
      const has = cv!=null && pv!=null && isFinite(cv) && isFinite(pv);
      let delta = '—', dcls = '';
      if(has){
        const d = cv-pv;
        delta = kind==='money' ? fmtMoney(d) : (kind==='pp' ? (d>=0?'+':'')+d.toFixed(0)+' pp' : (d>=0?'+':'')+(kind==='dec' ? d.toFixed(2) : d.toFixed(0)));
        if(better && d!==0) dcls = d>0 ? 'delta-up' : 'delta-down';
      }
      return '<tr><td>'+label+'</td><td class="num">'+(cv==null?'—':fmt(cv))+'</td><td class="num">'+(pv==null?'—':fmt(pv))+'</td><td class="num '+dcls+'">'+delta+'</td></tr>';
    }
    const g = function(b, f){ return b.m ? f(b.m) : null; };
    const pf = function(v){ return v===Infinity ? '∞' : v.toFixed(2); };
    const cleanPct = function(b){ return b.days ? Math.round(b.clean/b.days*100) : null; };
    document.querySelector('#monthCmpTable tbody').innerHTML =
      row('Net P&amp;L', g(cur,function(m){ return m.netPnl; }), g(prev,function(m){ return m.netPnl; }), fmtMoney, 'money', true)+
      row('Operaciones', cur.list.length, prev.list.length, String, 'int', false)+
      row('Win rate', g(cur,function(m){ return m.winRate; }), g(prev,function(m){ return m.winRate; }), function(v){ return v.toFixed(0)+'%'; }, 'pp', true)+
      row('Profit factor', g(cur,function(m){ return m.profitFactor; }), g(prev,function(m){ return m.profitFactor; }), pf, 'dec', true)+
      row('Expectancy', g(cur,function(m){ return m.expectancy; }), g(prev,function(m){ return m.expectancy; }), fmtMoney, 'money', true)+
      row('Días operados', cur.days, prev.days, String, 'int', false)+
      row('Días limpios', cleanPct(cur), cleanPct(prev), function(v){ return v+'%'; }, 'pp', true);
  }
  function renderHourWindow(trades){
    const wrap = document.getElementById('hwWrap'), sum = document.getElementById('hwSummary');
    if(!trades.length){ wrap.innerHTML = '<div class="sub-hint">Sin operaciones.</div>'; sum.innerHTML = ''; return; }
    const minN = Number(document.getElementById('hwMinN').value) || 1;
    const dowName = {1:'Lun',2:'Mar',3:'Mié',4:'Jue',5:'Vie',6:'Sáb',0:'Dom'};
    const cells = {}, byHour = {};
    let minH = 24, maxH = -1; const dows = {1:true,2:true,3:true,4:true,5:true};
    trades.forEach(function(t){
      const tp = tzParts(t.openTime), hr = tp.hour, dw = tp.dow;
      minH = Math.min(minH, hr); maxH = Math.max(maxH, hr); dows[dw] = true;
      const k = hr+'|'+dw; (cells[k] = cells[k] || []).push(t);
      (byHour[hr] = byHour[hr] || []).push(t);
    });
    const cols = [1,2,3,4,5,6,0].filter(function(d){ return dows[d]; });
    let maxAbs = 1;
    Object.keys(cells).forEach(function(k){ const m = computeMetrics(cells[k]); if(m.n>=minN) maxAbs = Math.max(maxAbs, Math.abs(m.expectancy)); });
    function cellHTML(list, title){
      if(!list) return '<td class="hm-empty">·</td>';
      const m = computeMetrics(list);
      const a = Math.min(.5, Math.abs(m.expectancy)/maxAbs*.5);
      const bg = m.expectancy>=0 ? 'rgba(45,212,167,'+a+')' : 'rgba(239,91,110,'+a+')';
      return '<td class="'+(m.n<minN?'hm-dim':'')+'" style="background:'+bg+';" title="'+esc(title+' · '+fmtMoney(m.expectancy)+' por op · '+m.n+' ops · WR '+m.winRate.toFixed(0)+'% · neto '+fmtMoney(m.netPnl))+'"><div class="hm-v">'+fmtMoney(m.expectancy)+'</div><div class="hm-s">'+m.n+' op · '+m.winRate.toFixed(0)+'%</div></td>';
    }
    let html = '<table class="hm"><thead><tr><th></th>'+cols.map(function(d){ return '<th>'+dowName[d]+'</th>'; }).join('')+'<th>Todos</th></tr></thead><tbody>';
    for(let hr=minH; hr<=maxH; hr++){
      const lab = String(hr).padStart(2,'0')+':00';
      html += '<tr><th class="rowh">'+lab+'</th>'+cols.map(function(d){ return cellHTML(cells[hr+'|'+d], dowName[d]+' '+lab); }).join('')+cellHTML(byHour[hr], 'Todos los días '+lab)+'</tr>';
    }
    wrap.innerHTML = html+'</tbody></table>';
    const ranked = Object.keys(cells).map(function(k){ const p = k.split('|'); return {hr:Number(p[0]), dw:Number(p[1]), m:computeMetrics(cells[k])}; })
      .filter(function(c){ return c.m.n>=minN; }).sort(function(a,b){ return b.m.expectancy-a.m.expectancy; });
    const lab = function(c){ return dowName[c.dw]+' '+String(c.hr).padStart(2,'0')+':00'; };
    if(ranked.length){
      const best = ranked[0], worst = ranked[ranked.length-1];
      sum.innerHTML =
        '<div class="m"><b class="'+pnlCls(best.m.expectancy)+'">'+lab(best)+'</b>mejor franja · '+fmtMoney(best.m.expectancy)+' por op · '+best.m.n+' ops</div>'+
        (ranked.length>1 ? '<div class="m"><b class="'+pnlCls(worst.m.expectancy)+'">'+lab(worst)+'</b>peor franja · '+fmtMoney(worst.m.expectancy)+' por op · '+worst.m.n+' ops</div>' : '');
    } else {
      sum.innerHTML = '<div class="sub-hint" style="margin:0;">Ninguna franja llega a '+minN+' operaciones. Baja el mínimo para ver resultados.</div>';
    }
  }
  document.getElementById('hwMinN').addEventListener('change', function(){ renderHourWindow(currentFilteredTrades()); });

  // ---------- sincronización segura ----------
  function fmtDT(ms){ return new Date(ms).toLocaleString('es-ES'); }
  function setCloudMeta(patch){
    localStorage.setItem(SYNC_CFG_KEY, JSON.stringify(Object.assign({}, getSyncConfig(), patch)));
  }
  async function fetchCloud(url, token){
    const res = await fetch(url+'/data', { headers:{'X-Auth-Token': token} });
    if(!res.ok) throw new Error('HTTP '+res.status);
    const data = await res.json();
    return data || {};
  }
  function dataCount(d){ return ((d&&d.rawRows)||[]).length + ((d&&d.perfRows)||[]).length + ((d&&d.manualTrades)||[]).length; }
  function showSyncBanner(html){
    const b = document.getElementById('syncBanner');
    if(!html){ b.style.display = 'none'; b.innerHTML = ''; return; }
    b.innerHTML = html; b.style.display = 'flex';
    const p = document.getElementById('sbPull');
    if(p) p.addEventListener('click', function(){ const c = getSyncConfig(); pullFromCloud((c.url||'').replace(/\/$/,''), c.token); });
    const x = document.getElementById('sbHide');
    if(x) x.addEventListener('click', function(){ showSyncBanner(''); });
  }
  async function checkCloud(manual){
    const cfg = getSyncConfig();
    if(!cfg.url || !cfg.token){ if(manual) toast('Rellena la URL y el token del Worker primero.'); return; }
    if(manual) setSyncStatus('Comprobando...');
    try{
      const cloud = await fetchCloud(cfg.url.replace(/\/$/,''), cfg.token);
      const cMod = Number(cloud.modifiedAt)||0, base = cfg.cloudMod||0;
      const cloudNewer = cMod>base, localNewer = modifiedAt>base;
      let status;
      if(cloudNewer && localNewer) status = 'Conflicto: la nube y este navegador tienen cambios distintos desde la última sincronización. Exporta un JSON de respaldo antes de elegir.';
      else if(cloudNewer) status = 'La nube tiene datos más recientes ('+fmtDT(cMod)+'). Descárgalos para no perderlos.';
      else if(localNewer) status = 'Este navegador tiene cambios sin subir a la nube.';
      else status = 'Todo sincronizado.';
      if(manual) setSyncStatus(status);
      if(cloudNewer){
        showSyncBanner('<span>☁️ '+h(cloudNewer && localNewer ? 'Conflicto de sincronización: la nube ('+fmtDT(cMod)+') y este navegador tienen cambios distintos.' : 'La nube tiene datos más recientes ('+fmtDT(cMod)+') que los de este navegador.')+'</span>'+
          '<span class="sb-actions"><button class="sm primary" id="sbPull">Descargar</button><button class="sm" id="sbHide">Ignorar</button></span>');
      } else showSyncBanner('');
    }catch(e){
      if(manual){ setSyncStatus(''); toast('No se pudo comprobar la nube: '+e.message); }
    }
  }
  document.getElementById('syncCheckBtn').addEventListener('click', function(){ checkCloud(true); });

  // ---------- v2: periodo, zona horaria, CSV, impresión, revisión, fondeo ----------
  document.querySelectorAll('#periodPicker .opt').forEach(function(o){
    o.addEventListener('click', function(){
      period.mode = o.dataset.p;
      if(period.mode==='custom' && !period.from && !period.to){ const d = new Date(); period.to = ymd(d); period.from = ymd(addDays(d,-29)); }
      saveUiPrefs(); render();
    });
  });
  ['periodFrom','periodTo'].forEach(function(id){
    document.getElementById(id).addEventListener('change', function(){
      period.from = document.getElementById('periodFrom').value; period.to = document.getElementById('periodTo').value;
      saveUiPrefs(); render();
    });
  });
  document.getElementById('tzMode').addEventListener('change', function(e){ tzMode = e.target.value==='ny' ? 'ny' : 'local'; saveUiPrefs(); render(); });
  document.getElementById('csvBtn').addEventListener('click', exportTradesCSV);
  document.getElementById('wkPrint').addEventListener('click', function(){
    const old = document.title;
    document.title = 'Informe semanal - '+document.getElementById('wkLabel').textContent;
    window.print();
    setTimeout(function(){ document.title = old; }, 600);
  });
  document.getElementById('reviewBtn').addEventListener('click', function(){
    const list = pendingList(currentFilteredTrades(), document.getElementById('pendFilter').value);
    if(!list.length){ toast('No hay operaciones pendientes con este filtro.'); return; }
    openTradeModal(list[0].id, {ids:list.map(function(t){ return t.id; }), review:true});
  });
  document.getElementById('groupFillsChk').addEventListener('change', function(e){
    groupFills = !!e.target.checked; process();
    toast(groupFills ? 'Las ejecuciones parciales se agrupan en una operación.' : 'Cada fila de Performance cuenta como una operación.');
  });
  document.getElementById('fundedSave').addEventListener('click', function(){
    const rows = {}; let bad = false;
    document.querySelectorAll('#fundedCfgBody input[data-a]').forEach(function(inp){
      const a = inp.dataset.a; rows[a] = rows[a] || {};
      if(inp.type==='checkbox'){ rows[a].lock = inp.checked; return; }
      const v = inp.value.trim(); if(v==='') return;
      const n = parseFloat(v);
      if(isNaN(n) || n<0){ bad = true; return; }
      rows[a][inp.dataset.f] = n;
    });
    if(bad){ toast('Revisa los datos de fondeo: hay un valor inválido.'); return; }
    const next = {};
    Object.keys(rows).forEach(function(a){ if(rows[a].start>0) next[a] = rows[a]; });
    fundedCfg = next; saveState(); render();
    toast('Cuentas de fondeo guardadas.');
  });
  // capturas: abre IndexedDB, registra qué operaciones tienen captura y migra las incrustadas de versiones anteriores
  shotStore.open().then(function(ok){
    if(!ok) return;
    return shotStore.keys().then(function(keys){
      keys.forEach(function(k){ shotIds.add(k); });
      const legacy = Object.keys(tradeMeta).filter(function(id){ return tradeMeta[id] && typeof tradeMeta[id].screenshot==='string' && tradeMeta[id].screenshot; });
      return Promise.all(legacy.map(function(id){
        const url = tradeMeta[id].screenshot;
        return shotStore.put(id, url).then(function(){ shotIds.add(id); tradeMeta[id].screenshot = null; }).catch(function(){});
      })).then(function(){
        skipTouch = true;
        try{ if(legacy.length) saveState(); if((keys.length || legacy.length) && (rawRows.length || perfRows.length || manualTrades.length)) process(); }
        finally{ skipTouch = false; }
      });
    });
  }).catch(function(){});

  // ---------- carga de estado guardado en este navegador ----------
  loadUiPrefs();
  document.getElementById('tzMode').value = tzMode;
  loadState();
  skipTouch = true; // cargar no cuenta como modificar (para la sincronización segura)
  try{ if(rawRows.length || perfRows.length || manualTrades.length) process(); else populateAccountFilter(); } finally { skipTouch = false; }
  setTimeout(function(){ checkCloud(false); }, 1200);
  // estado inicial de listas aunque no haya datos importados
  renderSetupsTagsLists();
  renderNotes();
})();
</script>
