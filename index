  // capturas de operaciones: IndexedDB (fuera de localStorage, que se llena enseguida)
  const shotStore = (function(){
    let db = null;
    const api = {ok:false};
    function store(mode){ return db.transaction('shots', mode).objectStore('shots'); }
    function wrap(req){ return new Promise(function(res, rej){ req.onsuccess = function(){ res(req.result); }; req.onerror = function(){ rej(req.error); }; }); }
    api.open = function(){
      return new Promise(function(res){
        try{
          const rq = indexedDB.open('tradingJournal_shots', 1);
          rq.onupgradeneeded = function(){ rq.result.createObjectStore('shots'); };
          rq.onsuccess = function(){ db = rq.result; api.ok = true; res(true); };
          rq.onerror = function(){ res(false); };
          rq.onblocked = function(){ res(false); };
        }catch(e){ res(false); }
      });
    };
    api.put = function(k, v){ try{ return wrap(store('readwrite').put(v, k)); }catch(e){ return Promise.reject(e); } };
    api.get = function(k){ try{ return wrap(store('readonly').get(k)); }catch(e){ return Promise.reject(e); } };
    api.del = function(k){ try{ return wrap(store('readwrite').delete(k)); }catch(e){ return Promise.reject(e); } };
    api.keys = function(){ try{ return wrap(store('readonly').getAllKeys()); }catch(e){ return Promise.reject(e); } };
    api.clear = function(){ if(!api.ok) return Promise.resolve(); try{ return wrap(store('readwrite').clear()); }catch(e){ return Promise.resolve(); } };
    return api;
