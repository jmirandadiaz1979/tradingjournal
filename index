  .gauge .g-top{color:var(--text-dim);} .gauge .g-val small{color:var(--text-dim);}
  .hm .hm-s{color:var(--text-dim);} .hm .hm-empty{color:var(--text-faint);}
  .je-metrics{color:var(--text);}
  .tag-picker .opt{color:var(--text);border-color:#34465f;}
  .tag-picker .grp-lbl{color:var(--text-dim);}
  .cat-tab{color:var(--text);border-color:#34465f;}
  .field label{color:var(--text-dim);}
  .modal-close{color:var(--text-dim);} .modal-close:hover{color:#fff;}
  .modal .modal-sub{color:var(--text-dim);}
  .fill-breakdown{color:var(--text);}
  .setup-card .sc-actions span{color:var(--text-dim);}
  .setup-card .sc-desc,.setup-card .sc-check-item{color:var(--text);}
  .note-card .nc-body{color:var(--text);}
  .tag-chip{color:var(--text);border-color:#34465f;}
  .legend-row{color:var(--text);}
  .import-summary{color:var(--text-dim);}
  .stars{color:#6b7c94;}
  .wk-line{color:var(--text);}
  .today-foot{color:var(--text-dim);}
  .chk-sum{color:var(--text-dim);}
  th{color:var(--text-dim);}
  ::placeholder{color:#8ea0b8;opacity:1;}
  .empty-state{color:var(--text);}
  button, .file-btn{border-color:#34465f;}
  .manual-edit,.manual-del{opacity:.8;}

  /* barra superior: periodo global */
  .topbar{position:sticky;top:0;z-index:60;display:flex;justify-content:space-between;align-items:center;gap:12px;flex-wrap:wrap;
    margin:-28px -34px 18px;padding:12px 34px;background:rgba(10,14,20,.92);backdrop-filter:blur(8px);-webkit-backdrop-filter:blur(8px);border-bottom:1px solid var(--border);}
  .topbar .tb-left{display:flex;align-items:center;gap:12px;flex-wrap:wrap;}
  .topbar .tb-lbl{font-size:11px;letter-spacing:.09em;text-transform:uppercase;font-weight:700;color:var(--text-dim);}
  .topbar .tb-right{font-size:12.5px;color:var(--text-dim);}
  .topbar .tb-right b{color:#fff;}
  #periodCustom{display:none;align-items:center;gap:6px;}
  #periodCustom input{padding:5px 8px;font-size:12px;}
  .tzbox{display:flex;align-items:center;gap:8px;font-size:12px;color:var(--text-dim);}
  .tzbox select{font-size:12px;padding:6px 9px;}
  .ssm{color:var(--yellow);font-size:11px;cursor:help;}
  .ci{color:var(--text-faint);font-size:11px;margin-left:2px;}
  .fillsn{color:var(--text-faint);font-size:10.5px;cursor:help;}

  /* sparklines y KPIs */
  .spark{display:block;width:100%;height:26px;margin-top:8px;opacity:.95;}
  #metricCards .card:first-child .spark{height:40px;}
  .card .value.sm14{font-size:15px;white-space:normal;}

  /* insights */
  .insight{display:flex;gap:10px;align-items:flex-start;padding:9px 0;border-bottom:1px solid #1d2a3f;font-size:13px;line-height:1.55;color:var(--text);}
