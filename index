  .hm .hm-v{font-weight:700;font-size:12.5px;color:var(--text);}
  .hm .hm-s{font-size:10.5px;color:var(--text-faint);margin-top:2px;}
  .hm .hm-dim{opacity:.38;}
  .hm .hm-empty{color:var(--text-faint);border-style:dashed;background:transparent;}
  .wk-line{padding:7px 0;border-bottom:1px solid #16202f;font-size:13px;color:var(--text-dim);line-height:1.55;}
  .wk-line:last-child{border-bottom:none;}
  .wk-line b{color:var(--text);}

  /* ---------- mejoras: panel Hoy ---------- */
  .st-ok{color:var(--green);background:var(--green-bg);border-color:rgba(45,212,167,.3);}
  .st-warn{color:var(--yellow);background:rgba(224,177,58,.10);border-color:rgba(224,177,58,.35);}
