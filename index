  // ---------- cuentas de fondeo ----------
  function fundedStatus(acc){
    const cfg = fundedCfg[acc];
    if(!cfg || !(cfg.start>0)) return null;
    const list = allTrades.filter(t=>t.account===acc).sort((a,b)=>a.closeTime-b.closeTime);
    let bal = cfg.start, peak = cfg.start; const byDay = {};
    list.forEach(t=>{ bal += t.pnl; peak = Math.max(peak, bal); const k = dayKey(t.closeTime); byDay[k] = (byDay[k]||0)+t.pnl; });
    const profit = bal-cfg.start, lock = cfg.lock!==false, maxDD = cfg.maxDD>0 ? cfg.maxDD : 0;
    let floor = null, locked = false;
    if(maxDD){ floor = peak-maxDD; if(lock && floor>=cfg.start){ floor = cfg.start; locked = true; } }
    const best = Object.keys(byDay).reduce((a,k)=>Math.max(a, byDay[k]), 0);
    const limit = cfg.consistency>0 ? cfg.consistency : 0;
    const ratio = profit>0 ? best/profit*100 : null;
    const consOk = !limit || ratio==null || ratio<=limit;
    return {cfg:cfg, bal:bal, peak:peak, profit:profit, floor:floor, locked:locked, dist:(floor!=null ? bal-floor : null), maxDD:maxDD, best:best, limit:limit, ratio:ratio, consOk:consOk,
      needProfit:(limit && ratio!=null && !consOk) ? best/(limit/100) : null, target:(cfg.target>0 ? cfg.target : 0), n:list.length, days:Object.keys(byDay).length};
  }
