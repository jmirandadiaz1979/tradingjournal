<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Trading Journal</title>
<meta name="theme-color" content="#0a0e14">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
<style>
  :root{
    --bg:#0a0e14; --panel:#111826; --panel-2:#0d1420; --panel-3:#0c1119; --border:#2a3a52;
    --text:#ffffff; --text-dim:#dce6f2; --text-faint:#b6c4d8;
    --green:#2dd4a7; --red:#ef5b6e; --purple:#8b6cf1; --blue:#4f9eea; --yellow:#e0b13a;
    --green-bg:rgba(45,212,167,.10); --red-bg:rgba(239,91,110,.10); --purple-bg:rgba(139,108,241,.12);
  }
  *{box-sizing:border-box;}
  body{margin:0;background:var(--bg);color:var(--text);font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,sans-serif;font-size:14px;}
  a{color:inherit;}
  .app{display:flex;min-height:100vh;}
  /* ---------- sidebar ---------- */
  .sidebar{width:220px;flex:none;background:var(--panel-3);border-right:1px solid var(--border);padding:20px 14px;display:flex;flex-direction:column;position:sticky;top:0;height:100vh;overflow-y:auto;}
  .brand{font-size:15px;font-weight:800;letter-spacing:-.01em;padding:0 8px 4px;}
  .brand span{display:block;font-size:10.5px;font-weight:500;color:var(--text-faint);letter-spacing:.06em;}
  .nav{margin-top:22px;display:flex;flex-direction:column;gap:2px;}
  .nav-item{padding:9px 12px;border-radius:8px;color:var(--text-dim);font-size:13.5px;font-weight:500;cursor:pointer;display:flex;align-items:center;gap:10px;}
  .nav-item:hover{background:#151f30;color:var(--text);}
  .nav-item.active{background:var(--purple-bg);color:#c4b5fd;}
  .nav-sep{height:1px;background:var(--border);margin:14px 4px;}
  .side-actions{margin-top:auto;display:flex;flex-direction:column;gap:8px;padding-top:14px;}
  .side-actions button, .side-actions .file-btn{width:100%;text-align:left;}
  .main-area{flex:1;min-width:0;padding:24px 30px 60px;max-width:1500px;}
  .view{display:none;} .view.active{display:block;}
  h1.page-title{font-size:19px;margin:0 0 4px;font-weight:700;}
  .page-sub{color:var(--text-dim);font-size:13px;margin-bottom:18px;}
  button, .file-btn{background:var(--panel);border:1px solid var(--border);color:var(--text);padding:9px 14px;border-radius:8px;font-size:13px;cursor:pointer;font-weight:500;transition:.15s;display:inline-block;}
  button:hover, .file-btn:hover{border-color:var(--purple);background:#151d2e;}
  .file-btn.primary, button.primary{background:var(--purple);border-color:var(--purple);color:#fff;}
  .file-btn.primary:hover, button.primary:hover{background:#7a5ce0;}
  button.danger{border-color:rgba(239,91,110,.4);color:var(--red);}
  button.danger:hover{background:var(--red-bg);}
  button.sm{padding:5px 10px;font-size:12px;}
  input[type=file]{display:none;}
  select, input[type=text], input[type=number], input[type=date], textarea{background:var(--panel);border:1px solid var(--border);color:var(--text);padding:8px 11px;border-radius:8px;font-size:13px;font-family:inherit;}
  textarea{width:100%;resize:vertical;}
  .filters{display:flex;gap:8px;flex-wrap:wrap;margin-bottom:14px;}
  .empty-state{margin-top:60px;text-align:center;color:var(--text-dim);}
  .empty-state svg{opacity:.3;margin-bottom:16px;}
  .empty-state h2{color:var(--text);font-size:17px;margin:0 0 8px;}
  .import-summary{background:var(--panel);border:1px solid var(--border);border-radius:10px;padding:16px 18px;margin:0 0 16px;font-size:13px;color:var(--text-dim);display:flex;gap:24px;flex-wrap:wrap;}
  .import-summary b{color:var(--text);}
  .grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(190px,1fr));gap:12px;margin:0 0 16px;}
  .card{background:var(--panel);border:1px solid var(--border);border-radius:10px;padding:16px 18px;}
  .card .label{font-size:11px;letter-spacing:.03em;color:var(--text-faint);margin-bottom:8px;}
  .card .value{font-size:22px;font-weight:700;letter-spacing:-.01em;}
  .card .sub{font-size:12px;color:var(--text-dim);margin-top:4px;}
  .pos{color:var(--green);} .neg{color:var(--red);}
  .row2{display:grid;grid-template-columns:1.4fr 1fr;gap:12px;margin:12px 0;}
  .row3{display:grid;grid-template-columns:1fr 1fr 1fr;gap:12px;margin:12px 0;}
  @media (max-width:1100px){.row2,.row3{grid-template-columns:1fr;}}
  .panel{background:var(--panel);border:1px solid var(--border);border-radius:10px;padding:18px 20px;margin-bottom:12px;}
  .panel h3{margin:0 0 4px;font-size:13px;font-weight:600;color:var(--text-dim);letter-spacing:.02em;text-transform:uppercase;}
  .panel .sub-hint{font-size:12px;color:var(--text-faint);margin-bottom:12px;}
  table{width:100%;border-collapse:collapse;font-size:12.5px;}
  th{text-align:left;color:var(--text-faint);font-weight:500;padding:8px 10px;border-bottom:1px solid var(--border);position:sticky;top:0;background:var(--panel);cursor:pointer;user-select:none;}
  th:hover{color:var(--text);}
  td{padding:8px 10px;border-bottom:1px solid #16202f;color:var(--text-dim);}
  tr.trade-row{cursor:pointer;}
  tr.trade-row:hover td{background:#0f1a2a;}
  .side-long{color:var(--green);font-weight:600;}
  .side-short{color:var(--red);font-weight:600;}
  .table-scroll{max-height:480px;overflow:auto;margin-top:8px;}
  .tag-chip{display:inline-block;background:var(--panel-2);border:1px solid var(--border);color:var(--text-dim);font-size:10.5px;padding:2px 7px;border-radius:20px;margin:0 3px 3px 0;}
  .setup-chip{display:inline-block;background:var(--purple-bg);color:#c4b5fd;font-size:10.5px;padding:2px 8px;border-radius:20px;}
  .cal-grid{display:grid;grid-template-columns:repeat(7,1fr);gap:6px;margin-top:10px;}
  .cal-day-label{font-size:11px;color:var(--text-faint);text-align:center;padding-bottom:4px;}
  .cal-cell{min-height:58px;border-radius:6px;padding:6px 8px;font-size:11px;border:1px solid var(--border);cursor:default;}
  .cal-cell.empty{border:none;}
  .cal-cell.has-journal{cursor:pointer;}
  .cal-cell .d{color:var(--text-faint);font-size:10px;display:flex;justify-content:space-between;}
  .cal-cell .p{font-weight:700;margin-top:4px;font-size:12px;}
  .cal-cell .j-dot{width:5px;height:5px;border-radius:50%;background:var(--blue);}
  .cal-nav{display:flex;align-items:center;gap:10px;font-size:12px;}
  .cal-nav button{padding:4px 10px;}
  .mult-table{width:100%;font-size:12.5px;border-collapse:collapse;}
  .mult-table td{padding:6px 8px;border-bottom:1px solid #16202f;}
  .mult-table input{width:80px;}
  .badge{font-size:10.5px;padding:2px 7px;border-radius:20px;background:var(--panel-2);color:var(--text-faint);}
  .badge.detected{color:var(--green);background:var(--green-bg);}
  .badge.fallback{color:var(--yellow);background:rgba(224,177,58,.1);}
  .badge.manual{color:var(--blue);background:rgba(79,158,234,.12);}
  .svg-wrap{width:100%;overflow-x:auto;}
  #toast{position:fixed;bottom:24px;right:24px;background:var(--panel);border:1px solid var(--border);padding:12px 18px;border-radius:8px;font-size:13px;display:none;box-shadow:0 8px 24px rgba(0,0,0,.4);z-index:200;}
  .modal-overlay{position:fixed;inset:0;background:rgba(0,0,0,.6);display:none;align-items:flex-start;justify-content:center;z-index:150;padding:40px 20px;overflow-y:auto;}
  .modal-overlay.open{display:flex;}
  .modal{background:var(--panel);border:1px solid var(--border);border-radius:12px;padding:24px 26px;width:100%;max-width:560px;}
  .modal h2{margin:0 0 2px;font-size:16px;}
  .modal .modal-sub{color:var(--text-dim);font-size:12.5px;margin-bottom:16px;}
  .modal-close{float:right;cursor:pointer;color:var(--text-faint);font-size:20px;line-height:1;}
  .field{margin-bottom:14px;}
  .field label{display:block;font-size:11.5px;color:var(--text-faint);margin-bottom:6px;text-transform:uppercase;letter-spacing:.02em;}
  .field select, .field input, .field textarea{width:100%;}
  .tag-picker{display:flex;flex-wrap:wrap;gap:6px;}
  .tag-picker .opt{padding:5px 11px;border-radius:20px;border:1px solid var(--border);font-size:12px;cursor:pointer;color:var(--text-dim);}
  .tag-picker .grp-lbl{flex-basis:100%;font-size:10.5px;color:var(--text-faint);text-transform:uppercase;letter-spacing:.06em;margin-top:4px;}
  .tag-picker .opt.sel{background:var(--purple);border-color:var(--purple);color:#fff;}
  .stars{font-size:22px;letter-spacing:2px;cursor:pointer;color:var(--text-faint);}
  .stars .on{color:var(--yellow);}
  .modal-actions{display:flex;gap:10px;margin-top:18px;}
  .fill-breakdown{font-size:12px;color:var(--text-faint);background:var(--panel-2);border-radius:8px;padding:10px 12px;margin-bottom:14px;}
  .list-manage{display:flex;flex-direction:column;gap:6px;margin-top:10px;}
  .list-manage .item{display:flex;justify-content:space-between;align-items:center;background:var(--panel-2);border:1px solid var(--border);border-radius:8px;padding:8px 12px;font-size:13px;}
  .list-manage .item .x{color:var(--text-faint);cursor:pointer;font-size:15px;}
  .add-row{display:flex;gap:8px;margin-top:12px;}
  .add-row input{flex:1;}
  .journal-entry{border:1px solid var(--border);border-radius:10px;padding:14px 16px;margin-bottom:10px;background:var(--panel-2);}
  .journal-entry .je-head{display:flex;justify-content:space-between;align-items:center;margin-bottom:8px;}
  .je-date{font-weight:700;font-size:13px;}
  .je-metrics{display:flex;gap:16px;font-size:12px;color:var(--text-dim);margin-bottom:6px;}
  .slider-row{display:flex;align-items:center;gap:10px;font-size:12.5px;color:var(--text-dim);margin-bottom:8px;}
  .slider-row input[type=range]{flex:1;accent-color:var(--purple);}
  .slider-row .sv{width:24px;text-align:right;color:var(--text);font-weight:600;}
  .kpi-mini{display:flex;gap:10px;flex-wrap:wrap;margin-bottom:10px;}
  .kpi-mini .m{background:var(--panel-2);border:1px solid var(--border);border-radius:8px;padding:8px 14px;font-size:12px;color:var(--text-dim);}
  .kpi-mini .m b{color:var(--text);display:block;font-size:15px;}
  .chart-tooltip{position:fixed;pointer-events:none;background:#0d1420;border:1px solid var(--border);border-radius:8px;padding:8px 12px;font-size:12px;line-height:1.5;color:var(--text);box-shadow:0 8px 24px rgba(0,0,0,.45);z-index:9999;opacity:0;transition:opacity .1s;white-space:nowrap;}
  .chart-tooltip.show{opacity:1;}
  .chart-tooltip b{color:#fff;}
  .legend-row{display:flex;gap:16px;flex-wrap:wrap;margin-top:10px;font-size:12px;color:var(--text-dim);}
  .legend-row .dot{display:inline-block;width:9px;height:9px;border-radius:50%;margin-right:6px;}
  .setup-card{background:var(--panel);border:1px solid var(--border);border-top:3px solid var(--purple);border-radius:10px;padding:16px 18px;}
  .setup-card .sc-head{display:flex;justify-content:space-between;align-items:flex-start;}
  .setup-card .sc-name{font-weight:700;font-size:14.5px;}
  .setup-card .sc-actions{display:flex;gap:10px;font-size:12px;}
  .setup-card .sc-actions span{cursor:pointer;color:var(--text-dim);}
  .setup-card .sc-actions span:hover{color:var(--text);}
  .setup-card .sc-actions .del{color:var(--red);}
  .setup-card .sc-desc{color:var(--text-dim);font-size:12px;margin:4px 0 10px;}
  .setup-card .sc-check-label{font-size:11px;color:var(--text-faint);text-transform:uppercase;letter-spacing:.02em;margin-bottom:6px;}
  .setup-card .sc-check-item{font-size:12.5px;color:var(--text-dim);margin-bottom:4px;}
  .setup-card .sc-footer{margin-top:10px;padding-top:10px;border-top:1px solid var(--border);font-size:11.5px;color:var(--text-faint);}
  .color-sw{width:20px;height:20px;border-radius:50%;cursor:pointer;border:2px solid transparent;display:inline-block;}
  .color-sw.sel{border-color:#fff;}
  .cat-tab{padding:6px 13px;border-radius:20px;border:1px solid var(--border);font-size:12px;cursor:pointer;color:var(--text-dim);}
  .cat-tab.sel{background:var(--purple);border-color:var(--purple);color:#fff;}
  .note-card{background:var(--panel);border:1px solid var(--border);border-radius:10px;padding:14px 16px;margin-bottom:10px;cursor:pointer;}
  .note-card:hover{border-color:var(--purple);}
  .note-card .nc-head{display:flex;justify-content:space-between;align-items:center;margin-bottom:6px;}
  .note-card .nc-title{font-weight:700;font-size:14px;}
  .note-card .nc-body{color:var(--text-dim);font-size:12.5px;white-space:pre-wrap;max-height:60px;overflow:hidden;}
  .note-card .nc-date{font-size:11px;color:var(--text-faint);margin-top:6px;}
  /* ---------- móvil ---------- */
  .mobile-menu-btn{display:none;}
  .sidebar-overlay{display:none;}
  @media (max-width:768px){
    .mobile-menu-btn{display:flex;position:fixed;top:12px;left:12px;z-index:220;width:38px;height:38px;align-items:center;justify-content:center;background:var(--panel);border:1px solid var(--border);border-radius:8px;color:var(--text);font-size:17px;}
    .app{flex-direction:column;}
    .sidebar{position:fixed;top:0;left:0;height:100vh;width:78%;max-width:270px;z-index:210;transform:translateX(-100%);transition:transform .22s ease;box-shadow:0 0 30px rgba(0,0,0,.5);}
    .sidebar.open{transform:translateX(0);}
    .sidebar-overlay{display:none;position:fixed;inset:0;background:rgba(0,0,0,.55);z-index:200;}
    .sidebar-overlay.open{display:block;}
    .main-area{padding:60px 10px 70px;max-width:100%;}
    h1.page-title{font-size:16.5px;}
    .page-sub{font-size:12px;}
    .grid{grid-template-columns:repeat(2,minmax(0,1fr));gap:8px;}
    .card{padding:11px 12px;}
    .card .value{font-size:17px;}
    .row2,.row3{grid-template-columns:1fr;gap:10px;margin:8px 0;}
    .panel{padding:13px 14px;}
    table{display:block;overflow-x:auto;-webkit-overflow-scrolling:touch;white-space:nowrap;}
    th,td{padding:6px 7px;}
    .modal-overlay{padding:16px 10px;}
    .modal{padding:16px 15px;max-width:100%;max-height:88vh;overflow-y:auto;}
    .filters{gap:6px;}
    .kpi-mini .m{padding:6px 10px;}
    .cal-cell{min-height:42px;padding:4px 5px;font-size:9.5px;}
    .cal-grid{gap:4px;}
    .cal-cell .p{font-size:10.5px;}
    .journal-entry{padding:12px 13px;}
    .setup-card{padding:13px 14px;}
    button, .file-btn{padding:8px 12px;font-size:12.5px;}
  }

  /* ================= POLISH PRO ================= */
  :root{ --radius:12px; --shadow:0 1px 0 rgba(255,255,255,.03) inset, 0 12px 28px -16px rgba(0,0,0,.7); --surface:linear-gradient(180deg,#121b2b,#101826); }
  html{color-scheme:dark;}
  body{font-family:'Inter',-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,sans-serif;font-feature-settings:'tnum' 1,'cv11' 1;-webkit-font-smoothing:antialiased;letter-spacing:-.005em;
       background:radial-gradient(1100px 480px at 72% -12%, rgba(139,108,241,.08), transparent 60%), var(--bg);}
  ::selection{background:rgba(139,108,241,.35);}
  *{scrollbar-width:thin;scrollbar-color:#25344c transparent;}
  ::-webkit-scrollbar{width:10px;height:10px;} ::-webkit-scrollbar-thumb{background:#25344c;border-radius:8px;border:2px solid transparent;background-clip:content-box;}
  input,select,textarea{color-scheme:dark;}
  :focus-visible{outline:2px solid rgba(139,108,241,.65);outline-offset:2px;}
  input:focus,select:focus,textarea:focus{outline:none;border-color:var(--purple);box-shadow:0 0 0 3px rgba(139,108,241,.18);}

  /* sidebar */
  .sidebar{background:linear-gradient(180deg,#0c1119,#090d14);padding:22px 14px;}
  .brand{display:flex;align-items:center;gap:11px;padding:0 6px 4px;font-size:14.5px;font-weight:700;letter-spacing:-.01em;line-height:1.2;}
  .brand .logo{width:32px;height:32px;border-radius:10px;background:linear-gradient(135deg,#8b6cf1,#4f9eea);display:flex;align-items:center;justify-content:center;box-shadow:0 8px 18px -8px rgba(139,108,241,.8);flex:none;padding:0;}
  .brand .logo svg{width:18px;height:18px;stroke:#fff;fill:none;stroke-width:2.2;stroke-linecap:round;stroke-linejoin:round;}
  .brand small{display:block;font-size:10.5px;font-weight:500;color:var(--text-faint);letter-spacing:.03em;margin-top:2px;}
  .nav-item{position:relative;gap:11px;font-size:13px;padding:9px 12px;transition:background .15s,color .15s;}
  .nav-item .ico{width:17px;height:17px;flex:none;stroke:currentColor;fill:none;stroke-width:1.8;stroke-linecap:round;stroke-linejoin:round;opacity:.9;}
  .nav-item.active{background:linear-gradient(90deg,rgba(139,108,241,.20),rgba(139,108,241,.04));color:#d8ccff;}
  .nav-item.active::before{content:'';position:absolute;left:-14px;top:8px;bottom:8px;width:3px;border-radius:0 3px 3px 0;background:var(--purple);}
  .side-actions button,.side-actions .file-btn{background:transparent;color:var(--text-dim);font-size:12.5px;padding:8px 12px;font-weight:500;}
  .side-actions button:hover,.side-actions .file-btn:hover{color:var(--text);background:#121a29;}
  .side-actions button.danger{color:var(--red);border-color:rgba(239,91,110,.3);}
  .side-actions .sub-hint{display:flex;align-items:center;gap:8px;font-size:11px;color:var(--text-faint);}
  .dot-live{width:6px;height:6px;border-radius:50%;background:var(--green);box-shadow:0 0 0 3px rgba(45,212,167,.15);flex:none;}
  #accountFilter{background:#0f1622;border-color:var(--border);font-size:12.5px;}

  /* cabeceras y superficies */
  .main-area{padding:28px 34px 72px;}
  h1.page-title{font-size:21px;font-weight:700;letter-spacing:-.02em;}
  .page-sub{color:var(--text-faint);font-size:13px;margin-bottom:22px;}
  .panel,.card,.setup-card,.note-card,.journal-entry,.import-summary{border-radius:var(--radius);box-shadow:var(--shadow);}
  .panel,.card,.setup-card,.note-card{background:var(--surface);}
  .panel{padding:20px 22px;}
  .panel h3{font-size:11px;letter-spacing:.1em;color:var(--text-faint);display:flex;align-items:center;gap:8px;font-weight:600;}
  .panel h3::before{content:'';width:3px;height:11px;border-radius:2px;background:var(--purple);flex:none;}
  .import-summary{padding:11px 16px;font-size:12px;gap:20px;background:transparent;box-shadow:none;}

  /* KPIs */
  .card{padding:16px 18px;transition:border-color .15s;}
  .card:hover{border-color:#2b3b55;}
  .card .label{font-size:10.5px;letter-spacing:.09em;text-transform:uppercase;font-weight:600;}
  .card .value{font-size:20px;font-weight:700;letter-spacing:-.02em;white-space:nowrap;}
  #metricCards{grid-template-columns:repeat(6,minmax(0,1fr));}
  #metricCards .card:first-child{grid-column:span 2;background:linear-gradient(135deg,rgba(139,108,241,.18),rgba(79,158,234,.06) 60%,#101826);border-color:rgba(139,108,241,.38);}
  #metricCards .card:not(:first-child){padding:15px 14px;}
  #metricCards .card:not(:first-child) .value{font-size:17px;white-space:normal;}
  #metricCards .card:first-child .value{font-size:30px;}
  @media (max-width:1280px){ #metricCards .card:not(:first-child) .value{font-size:20px;} #metricCards{grid-template-columns:repeat(auto-fit,minmax(170px,1fr));} #metricCards .card:first-child{grid-column:auto;} #metricCards .card:first-child .value{font-size:24px;} }

  /* tablas */
  th{font-size:10.5px;letter-spacing:.07em;text-transform:uppercase;font-weight:600;padding:10px 12px;background:#101826;}
  td{padding:11px 12px;border-bottom:1px solid #162134;}
  tr.trade-row:hover td{background:rgba(139,108,241,.06);}
  #tradesTable th:nth-child(5),#tradesTable td:nth-child(5),#tradesTable th:nth-child(6),#tradesTable td:nth-child(6),
  #tradesTable th:nth-child(7),#tradesTable td:nth-child(7),#tradesTable th:nth-child(8),#tradesTable td:nth-child(8),
  #tradesTable th:nth-child(14),#tradesTable td:nth-child(14){text-align:right;}
  #tradesTable td:nth-child(6){font-weight:600;}
  #tradesTable td{vertical-align:middle;}
  #tradesTable td:nth-child(1),#tradesTable td:nth-child(3),#tradesTable td:nth-child(9){white-space:nowrap;}
  .side-pill{display:inline-block;padding:2px 10px;border-radius:20px;font-size:11px;letter-spacing:.03em;}
  .side-pill.side-long{background:var(--green-bg);} .side-pill.side-short{background:var(--red-bg);}
  .manual-edit,.manual-del{opacity:.55;cursor:pointer;transition:opacity .12s;} .manual-edit:hover,.manual-del:hover{opacity:1;}
  .setup-chip{padding:2px 9px;font-weight:500;}
  .setup-chip.cat-zona{background:rgba(79,158,234,.18);color:#b5dbff;}
