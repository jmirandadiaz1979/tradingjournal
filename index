  // ---------- stats view ----------
  function renderStats(trades){
    const dowOrder = [1,2,3,4,5,6,0], dowNames = {1:'Lun',2:'Mar',3:'Mié',4:'Jue',5:'Vie',6:'Sáb',0:'Dom'};
    const byDow = {}; dowOrder.forEach(d=>{ byDow[d] = {value:0,count:0}; });
    trades.forEach(t=>{ const d=byDow[tzParts(t.closeTime).dow]; d.value+=t.pnl; d.count++; });
    barChart(document.getElementById('dowChart'), dowOrder.map(d=>({label:dowNames[d],value:byDow[d].value,count:byDow[d].count})));
    const byHour = Array.from({length:24},()=>({value:0,count:0}));
    trades.forEach(t=>{ const hb=byHour[tzParts(t.closeTime).hour]; hb.value+=t.pnl; hb.count++; });
    document.getElementById('hourTzBadge').textContent = tzMode==='ny' ? 'Nueva York (ET)' : 'hora local';
