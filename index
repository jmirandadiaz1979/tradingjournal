    t.chkDone = cs.done; t.chkTotal = cs.total; t.chkPct = cs.pct;
    t.riskAmount = meta.riskAmount || null;
    t.rMultiple = t.riskAmount ? (t.pnl/t.riskAmount) : null;
    t.stopPrice = meta.stopPrice != null ? meta.stopPrice : null;
    t.targetPrice = meta.targetPrice != null ? meta.targetPrice : null;
    t.screenshot = (meta.screenshot || shotIds.has(t.id)) ? true : null;
    t.plannedRR = computeRR(t.entryAvg, t.stopPrice, t.targetPrice);
