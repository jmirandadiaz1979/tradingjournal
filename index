  // renombra una cuenta en todas las fuentes de datos y migra las claves de tradeMeta que llevan el nombre incrustado
  function renameAccount(oldName, newName){
    rawRows.forEach(r=>{ if(r['Account']===oldName) r['Account']=newName; });
    perfRows.forEach(r=>{ if(r['Account']===oldName) r['Account']=newName; });
    manualTrades.forEach(t=>{ if(t.account===oldName) t.account=newName; });
    const newMeta = {};
    Object.keys(tradeMeta).forEach(id=>{
      let newId = id;
      if(id.startsWith('perf|'+oldName+'|')){ newId = 'perf|'+newName+id.slice(('perf|'+oldName).length); }
      else if(id.startsWith(oldName+'|')){ newId = newName+id.slice(oldName.length); }
      newMeta[newId] = tradeMeta[id];
    });
    tradeMeta = newMeta;
    process();
    toast('Cuenta renombrada a "'+newName+'".');
  }
  // elimina una cuenta y todos sus datos (filas de Orders/Performance, operaciones manuales y su playbook asociado)
  function deleteAccount(name){
    rawRows = rawRows.filter(r=>r['Account']!==name);
    perfRows = perfRows.filter(r=>r['Account']!==name);
    const manualIdsToRemove = manualTrades.filter(t=>t.account===name).map(t=>t.id);
    manualTrades = manualTrades.filter(t=>t.account!==name);
    manualIdsToRemove.forEach(id=>delete tradeMeta[id]);
    Object.keys(tradeMeta).forEach(id=>{
      if(id.startsWith(name+'|') || id.startsWith('perf|'+name+'|')) delete tradeMeta[id];
    });
    process();
    toast('Cuenta "'+name+'" eliminada.');
  }
  function renderCalendar(trades){
    const byDay={}, cnt={};
    trades.forEach(t=>{ const k=dayKey(t.closeTime); byDay[k]=(byDay[k]||0)+t.pnl; cnt[k]=(cnt[k]||0)+1; });
    const y=calMonth.getFullYear(), m=calMonth.getMonth();
    document.getElementById('calLabel').textContent = calMonth.toLocaleDateString('es-ES',{month:'long',year:'numeric'});
    const firstDow=(new Date(y,m,1).getDay()+6)%7; // semana de lunes a domingo, igual que el informe semanal
    const daysInMonth=new Date(y,m+1,0).getDate();
    const labels=['L','M','X','J','V','S','D'];
    let maxAbs=0;
    for(let d=1; d<=daysInMonth; d++){ const v=byDay[y+'-'+m+'-'+d]; if(v!=null) maxAbs=Math.max(maxAbs, Math.abs(v)); }
    let html = labels.map(l=>'<div class="cal-day-label">'+l+'</div>').join('')+'<div class="cal-day-label wk">Sem.</div>';
    let col=0, wkSum=0, wkCnt=0;
    function flushWeek(){
      html += '<div class="cal-cell week"><div class="d"><span>Σ</span></div>'+
        (wkCnt ? '<div class="p '+(wkSum>=0?'pos':'neg')+'">'+fmtMoney(wkSum)+'</div><div class="cnt">'+wkCnt+' op.</div>' : '')+'</div>';
      wkSum=0; wkCnt=0;
    }
    for(let i=0;i<firstDow;i++){ html+='<div class="cal-cell empty"></div>'; col++; }
    for(let d=1; d<=daysInMonth; d++){
      const k=y+'-'+m+'-'+d;
      const pnl=byDay[k];
      const hasJournal = !!dailyJournal[k];
      let style='', pnlHtml='';
      if(pnl!=null){
        const a = (0.10 + 0.45*(maxAbs ? Math.abs(pnl)/maxAbs : 0)).toFixed(2);
        style = pnl>=0 ? 'background:rgba(45,212,167,'+a+');border-color:rgba(45,212,167,.55);' : 'background:rgba(239,91,110,'+a+');border-color:rgba(239,91,110,.55);';
        pnlHtml = '<div class="p" style="color:#fff;">'+fmtMoney(pnl)+'</div><div class="cnt" style="color:#fff;opacity:.85;">'+cnt[k]+' op.</div>';
        wkSum += pnl; wkCnt += cnt[k];
      }
      html += '<div class="cal-cell'+(hasJournal?' has-journal':'')+'" data-day="'+k+'" style="'+style+'"><div class="d" style="'+(pnl!=null?'color:#fff;':'')+'"><span>'+d+'</span>'+(hasJournal?'<span class="j-dot"></span>':'')+'</div>'+pnlHtml+'</div>';
      col++;
      if(col===7){ flushWeek(); col=0; }
    }
    if(col>0){ for(let i=col;i<7;i++) html+='<div class="cal-cell empty"></div>'; flushWeek(); }
    document.getElementById('calGrid').innerHTML=html;
    document.querySelectorAll('#calGrid .cal-cell[data-day]').forEach(cell=>{
      cell.addEventListener('click', ()=>{
        document.querySelectorAll('.nav-item').forEach(n=>n.classList.remove('active'));
        document.querySelector('.nav-item[data-view="psych"]').classList.add('active');
        document.querySelectorAll('.view').forEach(v=>v.classList.remove('active'));
        document.getElementById('view-psych').classList.add('active');
        const k = cell.dataset.day.split('-');
        document.getElementById('jDate').value = ymd(new Date(Number(k[0]), Number(k[1]), Number(k[2])));
        loadJournalFormFor(cell.dataset.day);
      });
    });
  }
