        if(!confirm('No se pudo comprobar si la nube tiene datos más recientes ('+e.message+').\n\n¿Subir de todas formas?')){ setSyncStatus('Subida cancelada.'); return; }
      }
      if(cloud){
        const cMod = Number(cloud.modifiedAt)||0;
        if(cMod && cMod > (cfg.cloudMod||0)){
          if(!confirm('⚠️ La nube tiene datos más recientes ('+fmtDT(cMod)+') que tu última sincronización en este navegador ('+(cfg.lastSync?fmtDT(cfg.lastSync):'nunca')+').\n\nSi subes ahora, se perderán esos cambios. Cancela y descarga primero si no quieres perderlos.\n\n¿Subir igualmente?')){
            setSyncStatus('Subida cancelada. Descarga primero los cambios de la nube.'); return;
          }
        } else if(dataCount(cloud)>0 && (rawRows.length+perfRows.length+manualTrades.length)===0){
          if(!confirm('Este navegador no tiene operaciones y la nube sí. Si subes, la nube se quedará vacía.\n\n¿Subir igualmente?')){ setSyncStatus('Subida cancelada.'); return; }
        }
      }
      setSyncStatus('Subiendo...');
      const pushedMod = modifiedAt || Date.now();
      modifiedAt = pushedMod;
      const res = await fetch(url+'/data', {
        method:'POST',
        headers:{'Content-Type':'application/json', 'X-Auth-Token': token},
        body: JSON.stringify(snapshot())
      });
      if(!res.ok) throw new Error('HTTP '+res.status);
      const now = Date.now();
      skipTouch = true; saveState(); skipTouch = false;
      setCloudMeta({url, token, lastSync: now, cloudMod: pushedMod});
      loadSyncConfigIntoUI();
      showSyncBanner('');
      setSyncStatus('Última sincronización: '+fmtDT(now));
      toast('Datos subidos a la nube.');
    }catch(err){ setSyncStatus(''); toast('Error al subir: '+err.message); }
  });
  // lógica de descarga compartida entre el botón de Ajustes y el de la pantalla vacía
  async function pullFromCloud(url, token){
    if(!url || !token){ toast('Rellena la URL y el token del Worker primero.'); return; }
    const hasLocalData = rawRows.length || perfRows.length || manualTrades.length || Object.keys(dailyJournal).length || notesList.length;
    setSyncStatus('Descargando...');
    try{
      const data = await fetchCloud(url, token);
      const cfg = getSyncConfig();
      if(hasLocalData){
        const cloudEmpty = !dataCount(data) && !(data.notesList||[]).length && !Object.keys(data.dailyJournal||{}).length;
        let msg = null;
        if(cloudEmpty) msg = 'La nube está vacía. Si descargas, este navegador también se quedará vacío.';
        else if(cfg.cloudMod==null) msg = 'Esto sobrescribirá los datos de este navegador con los de la nube, y no puedo comprobar si tienes cambios sin subir.';
        else if(modifiedAt > cfg.cloudMod) msg = '⚠️ Este navegador tiene cambios sin subir (último cambio: '+fmtDT(modifiedAt)+'). Si descargas, se perderán.';
        if(msg && !confirm(msg+'\n\n¿Descargar de todas formas?')){ setSyncStatus('Descarga cancelada.'); return; }
      }
      skipTouch = true;
      try{
        rawRows = data.rawRows || [];
        perfRows = data.perfRows || [];
        manualTrades = data.manualTrades || [];
        multipliers = data.multipliers || {};
        commissions = data.commissions || {};
        multSource = data.multSource || {};
        tradeMeta = data.tradeMeta || {};
        if(data.setupsList && data.setupsList.length) setupsList = normalizeSetups(data.setupsList);
        if(data.setupsVersion!==4) migrateSetups();
        if(data.tagsList && data.tagsList.length) tagsList = data.tagsList;
        dailyJournal = data.dailyJournal || {};
        notesList = data.notesList || [];
        rules = Object.assign({}, DEFAULT_RULES, data.rules || {});
        modifiedAt = Number(data.modifiedAt) || Date.now();
        fundedCfg = data.fundedCfg || {};
        groupFills = data.groupFills !== false;
        checklistsSeeded = !!data.checklistsSeeded;
        seedChecklists();
        absorbInlineShots(tradeMeta);
        process();
        renderNotes();
      } finally { skipTouch = false; }
      const now = Date.now();
      setCloudMeta({url, token, lastSync: now, cloudMod: modifiedAt});
      loadSyncConfigIntoUI();
      showSyncBanner('');
      setSyncStatus('Última sincronización: '+fmtDT(now));
      toast('Datos descargados de la nube.');
    }catch(err){ setSyncStatus(''); toast('Error al descargar: '+err.message); }
  }
