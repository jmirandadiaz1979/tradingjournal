  // ---------- exportar CSV ----------
  function csvEscape(v){ const s = String(v==null?'':v); return /[;"\n\r]/.test(s) ? '"'+s.replace(/"/g,'""')+'"' : s; }
  function csvNum(n, dec){ if(n==null || isNaN(n)) return ''; return (dec!=null ? Number(n).toFixed(dec) : String(n)).replace('.',','); }
  function dtLocal(ms){ const d = new Date(ms); return ymd(d)+' '+pad2(d.getHours())+':'+pad2(d.getMinutes())+':'+pad2(d.getSeconds()); }
  function exportTradesCSV(){
    const list = applyTradeFilters(currentFilteredTrades()).slice().sort((a,b)=>a.closeTime-b.closeTime);
    if(!list.length){ toast('No hay operaciones que exportar con los filtros actuales.'); return; }
    const head = ['Cierre','Apertura','Cuenta','Contrato','Lado','Qty','Entrada','Salida','P&L bruto','Comisión','P&L neto','Riesgo $','R real','R:R plan','Checklist %','Setups','Tags','Emoción','Plan seguido','Tipo de salida','Valoración','Duración (s)','Notas'];
    const rows = list.map(function(t){
      return [dtLocal(t.closeTime), dtLocal(t.openTime), t.account, t.contract, t.side, t.qty, csvNum(t.entryAvg,2), csvNum(t.exitAvg,2),
        csvNum(t.pnlGross!=null?t.pnlGross:t.pnl,2), csvNum(t.commissionPaid||0,2), csvNum(t.pnl,2), csvNum(t.riskAmount,2), csvNum(t.rMultiple,2),
        csvNum(t.plannedRR,2), t.chkPct!=null?t.chkPct:'', (t.setups||[]).join(' + '), (t.tags||[]).join(', '), t.emotion||'',
        t.planFollowed==='si'?'Sí':(t.planFollowed==='no'?'No':''), t.exitType||'', t.rating||'', Math.round((t.durationMs||0)/1000), t.notes||''];
    });
    const csv = '﻿'+[head].concat(rows).map(r=>r.map(csvEscape).join(';')).join('\r\n');
    const a = document.createElement('a');
    a.href = URL.createObjectURL(new Blob([csv], {type:'text/csv;charset=utf-8'}));
    a.download = 'operaciones-'+ymd(new Date())+'.csv';
    a.click();
    toast(list.length+' operaciones exportadas a CSV.');
  }

  // ---------- proyección a futuro (extrapolación estadística simple, no es una garantía de resultados) ----------
  function renderProjection(trades){
    const wrap = document.getElementById('projectionPanel');
    const svg = document.getElementById('projectionChart');
    if(trades.length < 5){
      wrap.innerHTML = '<div class="sub-hint">Necesitas al menos 5 operaciones registradas para calcular una proyección.</div>';
      svg.innerHTML=''; return;
    }
    const sorted=[...trades].sort((a,b)=>a.closeTime-b.closeTime);
    const byDay={};
    sorted.forEach(t=>{ const k=dayKey(t.closeTime); byDay[k]=(byDay[k]||0)+t.pnl; });
    const tradedDays = Object.keys(byDay).length;
    const totalPnl = sorted.reduce((s,t)=>s+t.pnl,0);
    const avgDaily = totalPnl/tradedDays;
    const tradesPerDay = sorted.length/tradedDays;
    const proj = [30,60,90].map(d=>({days:d, val:avgDaily*d}));
    wrap.innerHTML =
      '<div class="m">P&amp;L medio/día operado <b class="'+(avgDaily>=0?'pos':'neg')+'">'+fmtMoney(avgDaily)+'</b></div>'+
      '<div class="m">Operaciones/día <b>'+tradesPerDay.toFixed(1)+'</b></div>'+
      proj.map(p=>'<div class="m">Proyección '+p.days+' días <b class="'+(p.val>=0?'pos':'neg')+'">'+fmtMoney(p.val)+'</b></div>').join('');
    const W=Math.max(500, svg.parentElement.clientWidth||600), H=200, padL=60, padB=20, padT=10;
    let cum=0; const realPts = sorted.map((t,i)=>{ cum+=t.pnl; return {x:i,y:cum}; });
    const lastReal = realPts[realPts.length-1];
    const projPts = proj.map((p,i)=>({x: realPts.length-1 + (i+1), y: lastReal.y + p.val, days:p.days}));
    const allPts = realPts.concat(projPts);
    const minY=Math.min(0,...allPts.map(p=>p.y)), maxY=Math.max(0,...allPts.map(p=>p.y));
    const range=(maxY-minY)||1;
    const x = i => padL + (i/(allPts.length-1||1))*(W-padL-10);
    const y = v => H-padB - ((v-minY)/range)*(H-padB-padT);
    const realPath='M'+realPts.map(p=>x(p.x)+','+y(p.y)).join(' L');
    const projPath='M'+x(lastReal.x)+','+y(lastReal.y)+' L'+projPts.map(p=>x(p.x)+','+y(p.y)).join(' L');
    const gridLines=[minY, minY+range/2, maxY].map(v=>
      '<line x1="'+padL+'" y1="'+y(v)+'" x2="'+W+'" y2="'+y(v)+'" stroke="#2a3a52" stroke-width="1"/>'+
      '<text x="4" y="'+(y(v)+4)+'" fill="#c3d0e2" font-size="10">'+fmtMoneyPlain(v)+'</text>'
    ).join('');
    const projHits = projPts.map(p=>{
      const ttHtml = '<b>Proyección a '+p.days+' días</b><br>'+fmtMoney(p.y)+' acumulado estimado';
      return '<circle class="chart-hit" data-tt="'+esc(ttHtml)+'" cx="'+x(p.x)+'" cy="'+y(p.y)+'" r="6" fill="'+(p.y>=0?'#2dd4a7':'#ef5b6e')+'" opacity="0.85" style="cursor:pointer;"/>';
    }).join('');
    svg.setAttribute('viewBox','0 0 '+W+' '+H);
    svg.innerHTML = gridLines+
      '<path d="'+realPath+'" fill="none" stroke="'+(lastReal.y>=0?'#2dd4a7':'#ef5b6e')+'" stroke-width="2"/>'+
      '<path d="'+projPath+'" fill="none" stroke="#8b6cf1" stroke-width="2" stroke-dasharray="5,4"/>'+
      projHits;
    attachChartTooltips(svg);
  }
