  // gráfico de línea genérico (equity en R, drawdown)
  function lineChart(svgEl, pts, opts){
    opts = opts || {};
    if(!pts.length){ svgEl.innerHTML=''; return; }
    const W = Math.max(300, svgEl.parentElement.clientWidth || 500), H = opts.h || 200, padL = 62, padB = 18, padT = 10;
    const ys = pts.map(function(p){ return p.y; });
    const minY = Math.min(0, Math.min.apply(null, ys)), maxY = Math.max(0, Math.max.apply(null, ys));
    const range = (maxY-minY) || 1;
    const x = function(i){ return padL + (i/(pts.length-1||1))*(W-padL-10); };
    const y = function(v){ return H-padB - ((v-minY)/range)*(H-padB-padT); };
    const color = opts.color || '#2dd4a7', fmt = opts.fmt || function(v){ return v.toFixed(2); };
    const gid = 'lg'+Math.random().toString(36).slice(2,8);
    const path = 'M'+pts.map(function(p,i){ return x(i)+','+y(p.y); }).join(' L');
    const area = path+' L'+x(pts.length-1)+','+y(0)+' L'+x(0)+','+y(0)+' Z';
    const grid = [minY, minY+range/2, maxY].map(function(v){
      return '<line x1="'+padL+'" y1="'+y(v)+'" x2="'+W+'" y2="'+y(v)+'" stroke="#2a3a52" stroke-width="1"/>'+
        '<text x="4" y="'+(y(v)+4)+'" fill="#c3d0e2" font-size="10">'+fmt(v)+'</text>';
    }).join('');
    const hits = pts.map(function(p,i){
      const tt = '<b>'+esc(p.label||'')+'</b><br>'+fmt(p.y);
      return '<circle class="chart-hit" data-tt="'+esc(tt)+'" cx="'+x(i)+'" cy="'+y(p.y)+'" r="7" fill="transparent" style="cursor:pointer;"/>';
    }).join('');
    svgEl.setAttribute('viewBox','0 0 '+W+' '+H);
    svgEl.innerHTML = '<defs><linearGradient id="'+gid+'" x1="0" y1="0" x2="0" y2="1"><stop offset="0%" stop-color="'+color+'" stop-opacity=".26"/><stop offset="100%" stop-color="'+color+'" stop-opacity="0"/></linearGradient></defs>'+
      grid+
      '<line x1="'+padL+'" y1="'+y(0)+'" x2="'+W+'" y2="'+y(0)+'" stroke="#34445f" stroke-dasharray="4 4"/>'+
      '<path d="'+area+'" fill="url(#'+gid+')" stroke="none"/>'+
      '<path d="'+path+'" fill="none" stroke="'+color+'" stroke-width="2.2" stroke-linejoin="round" stroke-linecap="round"/>'+hits;
    attachChartTooltips(svgEl);
  }

  // ---------- pestaña Disciplina ----------
  function renderDiscipline(trades){
    const ev = ruleEval ? {days:ruleEval.days.filter(d=>inPeriod(d.date)), trades:ruleEval.trades.filter(t=>inPeriod(t.closeTime))} : null;
    const cardsEl = document.getElementById('disciplineCards');
    if(!ev || !ev.days.length){
      cardsEl.innerHTML = '<div class="sub-hint">Sin operaciones todavía.</div>';
      ['ruleTable','tagCostTable','dayHistTable'].forEach(function(id){ document.querySelector('#'+id+' tbody').innerHTML=''; });
      ['tagCostChart','opNumChart'].forEach(function(id){ document.getElementById(id).innerHTML=''; });
      document.getElementById('tiltCards').innerHTML='';
      return;
    }
    const days = ev.days, all = ev.trades;
    const clean = days.filter(function(d){ return d.clean; }).length;
    const bad = all.filter(function(t){ return t.ruleBreaks.length; });
    const good = all.filter(function(t){ return !t.ruleBreaks.length; });
    const pIn = good.reduce(function(s,t){ return s+t.pnl; },0), pOut = bad.reduce(function(s,t){ return s+t.pnl; },0);
    const counts = RULE_KEYS.map(function(k){ return {k:k, days:days.filter(function(d){ return d.viol[k]; }).length}; }).sort(function(a,b){ return b.days-a.days; });
    const top = counts[0].days ? ruleChip(counts[0].k)+' ('+counts[0].days+' días)' : 'Ninguna';
    let run = 0, bestRun = 0;
    days.forEach(function(d){ if(d.clean){ run++; bestRun = Math.max(bestRun, run); } else run = 0; });
    const streakCards =
      '<div class="card"><div class="label">Racha limpia actual</div><div class="value '+(run?'pos':'')+'">'+run+(run===1?' día':' días')+'</div><div class="sub">días operados seguidos sin romper reglas</div></div>'+
      '<div class="card"><div class="label">Mejor racha limpia</div><div class="value">'+bestRun+(bestRun===1?' día':' días')+'</div></div>';
    cardsEl.innerHTML =
      '<div class="card"><div class="label">Días limpios</div><div class="value '+(clean===days.length?'pos':'')+'">'+Math.round(clean/days.length*100)+'%</div><div class="sub">'+clean+' de '+days.length+' días operados</div></div>'+
      '<div class="card"><div class="label">Ops fuera de reglas</div><div class="value '+(bad.length?'neg':'pos')+'">'+bad.length+'</div><div class="sub">'+Math.round(bad.length/all.length*100)+'% de '+all.length+' operaciones</div></div>'+
      '<div class="card"><div class="label">P&amp;L dentro de reglas</div><div class="value '+pnlCls(pIn)+'">'+fmtMoney(pIn)+'</div><div class="sub">'+good.length+' operaciones</div></div>'+
      '<div class="card"><div class="label">P&amp;L fuera de reglas</div><div class="value '+pnlCls(pOut)+'">'+fmtMoney(pOut)+'</div><div class="sub">'+bad.length+' operaciones</div></div>'+
      '<div class="card"><div class="label">Regla más rota</div><div class="value" style="font-size:16px;white-space:normal;">'+h(top)+'</div></div>'+streakCards;

    document.querySelector('#ruleTable tbody').innerHTML = RULE_KEYS.map(function(k){
      const dd = days.filter(function(d){ return d.viol[k]; }).length;
      const ops = all.filter(function(t){ return t.ruleBreaks.indexOf(k)>=0; });
      const p = ops.reduce(function(s,t){ return s+t.pnl; },0);
      return '<tr><td>'+h(ruleLabel(k))+'</td><td>'+(dd ? '<span class="badge bad">'+dd+'</span>' : '<span class="badge detected">0</span>')+'</td><td>'+ops.length+'</td>'+
        '<td class="'+pnlCls(p)+'">'+(ops.length ? fmtMoney(p) : '—')+'</td></tr>';
    }).join('');

    document.querySelector('#dayHistTable tbody').innerHTML = days.slice().reverse().slice(0,60).map(function(d){
      const chips = d.clean ? '<span class="badge detected">Limpio</span>'
        : RULE_KEYS.filter(function(k){ return d.viol[k]; }).map(function(k){ return '<span class="badge bad">'+h(ruleChip(k))+'</span>'; }).join(' ');
      return '<tr><td>'+new Date(d.date).toLocaleDateString('es-ES',{weekday:'short',day:'numeric',month:'short'})+'</td><td>'+d.trades.length+'</td><td>'+d.losses+'</td><td>'+d.sl+'</td>'+
        '<td class="'+pnlCls(d.pnl)+'">'+fmtMoney(d.pnl)+'</td><td>'+chips+'</td></tr>';
    }).join('');

    // coste de cada error (tags)
    const tagGroups = {};
    all.forEach(function(t){ (t.tags||[]).forEach(function(g){ (tagGroups[g] = tagGroups[g] || []).push(t); }); });
    const tagArr = Object.keys(tagGroups).map(function(n){ return {name:n, list:tagGroups[n]}; });
    fillStatTable('tagCostTable', tagArr, 'Marca tags en tus operaciones para ver cuánto cuesta cada error.', true);
    const tagData = tagArr.map(function(g){ return {label:shortLabel(g.name,9), tooltipLabel:g.name, value:g.list.reduce(function(s,t){ return s+t.pnl; },0), count:g.list.length}; })
      .sort(function(a,b){ return a.value-b.value; });
    barChart(document.getElementById('tagCostChart'), tagData, {h:170});

    // tilt
    function tiltCard(label, list){
      if(!list.length) return '<div class="m"><b>—</b>'+label+' · 0 ops</div>';
      const m = computeMetrics(list);
      return '<div class="m"><b class="'+pnlCls(m.expectancy)+'">'+fmtMoney(m.expectancy)+'</b>'+label+' · '+m.n+' ops · WR '+m.winRate.toFixed(0)+'%</div>';
    }
    document.getElementById('tiltCards').innerHTML =
      tiltCard('1ª del día', all.filter(function(t){ return t.prevResult==='first'; }))+
      tiltCard('Tras ganancia', all.filter(function(t){ return t.prevResult==='win'; }))+
      tiltCard('Tras pérdida', all.filter(function(t){ return t.prevResult==='loss'; }))+
      tiltCard('Tras 2+ pérdidas seguidas', all.filter(function(t){ return t.prevLossStreak>=2; }));
    const cap = Math.max(rules.maxOps+1, 6);
    const seq = {};
    all.forEach(function(t){ const k = Math.min(t.seqInDay, cap); (seq[k] = seq[k] || []).push(t); });
    const seqData = Object.keys(seq).map(Number).sort(function(a,b){ return a-b; }).map(function(k){
      const m = computeMetrics(seq[k]);
