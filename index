<script>
(function(){
  'use strict';
  // ---------- estado ----------
  let rawRows = [];      // filas de Orders.csv (contexto: canceladas, rechazadas, posiciones abiertas)
  let perfRows = [];     // filas de Performance.csv (P&L real de Tradovate, fuente de verdad cuando existe)
  let manualTrades = []; // operaciones añadidas a mano (no vienen de ningún CSV)
  let allTrades = [];
  let openPositions = [];
  let multipliers = {};
  let multSource = {};
  let commissions = {};  // product -> $ round-turn por contrato, descontado automáticamente del P&L
  let modifiedAt = 0;      // marca de tiempo de la última modificación local (sincronización segura)
  let skipTouch = false;   // true mientras se carga/descarga estado: no cuenta como modificación
  let lastTodayLevel = null; // último nivel del semáforo de "Hoy" (para avisar al llegar al límite)
  let tmChecks = {}, mmChecks = {}; // setup -> [textos del checklist marcados]
  let tmExit = '', mmExit = '';
  const EXIT_TYPES = [['SL','SL'],['TP','TP'],['manual','Manual'],['BE','BE']];
  const EXIT_LABEL = {SL:'SL', TP:'TP', manual:'Manual', BE:'BE'};
  let calMonth = new Date();
  // --- estado v2 ---
  let period = {mode:'all', from:'', to:''};   // filtro global de periodo (solo se guarda en este dispositivo)
  let tzMode = 'local';                         // 'local' | 'ny' (solo análisis por hora)
  let fundedCfg = {};                           // cuenta -> {start,target,maxDD,consistency,lock}
  let checklistsSeeded = false;                 // los checklist por defecto se cargan una sola vez
  let groupFills = true;                        // agrupar fills parciales de Performance en una operación
  let lastTableIds = [];                        // ids en el orden mostrado en la tabla de operaciones
  let navIds = [], navIdx = -1, reviewMode = false, tmInitialSig = '';
  let shotState = {changed:false, url:null};    // captura del modal de operación
  const shotIds = new Set();                    // ids de operaciones con captura guardada en IndexedDB
  let sortKey = 'closeTime', sortDir = -1;
  let tradeMeta = {};   // id -> {setups[],tags[],notes,rating,riskAmount}
  let dataSource = 'none'; // 'none' | 'orders' | 'performance' | 'both'
  let tmSelectedSetups = [];
  let editingManualId = null;
  let mtPnlTouched = false, mmRiskTouched = false;
  let mmSelectedSetups = [];
  let mmSelectedTags = [];
  let mmSelectedRating = 0;
  const DEFAULT_SETUPS = [
    {id:'st_zona', name:'Reacción en zona', category:'otro', color:'#8b6cf1', description:'Esperas a que el precio llegue a una zona relevante (VWAP, FVG, IFVG, LVN, POC, VA/VAH/VAL…) y operas la reacción que muestra al tocarla.', checklist:["Zona relevante marcada antes de que llegue el precio (VWAP, FVG, IFVG, LVN, POC, VA…)","Sesgo del timeframe mayor a favor o, al menos, neutro","Reacción visible al tocar la zona (rechazo, absorción, pérdida de velocidad)","Entrada tras la reacción, no a ciegas en el primer toque","Stop definido más allá de la zona","R:R planeado ≥ 1:2"]},
    {id:'st_impulso', name:'Perfil del impulso', category:'otro', color:'#2dd4a7', description:'Tras un impulso fuerte que rompe estructura en timeframes superiores, trazas un perfil de volumen con footprint del inicio al final del impulso. Marca el POC y los nodos LVN; entras en ellos, a favor del impulso, cuando el precio retrocede a esos niveles.', checklist:["Impulso fuerte que rompe estructura en un timeframe superior","Perfil de volumen trazado del inicio al final del impulso","POC y nodos LVN del impulso marcados","El retroceso llega a un POC o a un LVN del perfil","Entrada en dirección del impulso, con reacción en el nivel","Stop más allá del nivel o del nodo","R:R planeado ≥ 1:2"]}
  ];
  const OLD_DEFAULT_SETUP_NAMES = ['LVN','FVG','IFVG','VWAP','CVD','Absorción','Stacked Imbalance','Imbalance','Delta agresivo','No setup'];
  const SETUP_CATS = [['zona','Zona'],['confirmacion','Confirmación'],['otro','Setups']];
  let setupsList = DEFAULT_SETUPS.map(d=>Object.assign({}, d, {checklist:[...d.checklist]}));
  let tagsList = ['FOMO','Revenge Trade','Sobredimensionado','Salida temprana','Salida tardía','Buena ejecución','Ignoré el plan'];
  let dailyJournal = {}; // 'YYYY-M-D' -> {disciplina,energia,emocion,nota,updatedAt}
  let notesList = []; // {id,title,category,content,createdAt,updatedAt}
  let activeTradeId = null;
  let activeNoteId = null;
  let editingSetupId = null;
  let tmSelectedTags = [];
  let tmSelectedRating = 0;
  let tmShotDataUrl = null;
  let stChecklist = [];
  let stSelectedColor = '#8b6cf1';
  let activeNoteCat = '';
  let dashboardMode = '$';
  const DEFAULT_RULES = {s1Start:9, s1End:13, s2Start:16, s2End:20, maxLoss:500, maxOps:5, maxSL:2};
  let rules = Object.assign({}, DEFAULT_RULES);
  const EMOTIONS = ['Neutral','Confiado','Ansioso','Frustrado','Eufórico','Cansado','Enfocado'];
  let tmEmotion = '', tmPlan = '', mmEmotion = '', mmPlan = '';
  let weekStart = null, weeklyText = '', ruleEval = null;
  const SETUP_COLORS = ['#a78bfa','#60a5fa','#fbbf24','#ef4444','#8b6cf1','#34d399','#f472b6','#fb923c','#2dd4a7','#d946ef'];
  const NOTE_CATS = [['General','General'],['Lesson','Lección'],['Strategy','Estrategia'],['Mistake','Error'],['Idea','Idea'],['Review','Revisión']];
  const DEFAULT_MULTIPLIERS = {
    ES:50, MES:5, NQ:20, MNQ:2, YM:5, MYM:0.5, RTY:50, M2K:5,
    GC:100, MGC:10, SI:5000, CL:1000, MCL:100, NG:10000,
    ZB:1000, ZN:1000, ZC:50, ZS:50, ZW:50
  };
  // rellena una sola vez los checklist vacíos de los setups por defecto (no pisa los tuyos)
  function seedChecklists(){
    if(checklistsSeeded) return;
    setupsList.forEach(function(s){
      const d = DEFAULT_SETUPS.find(function(x){ return x.name===s.name; });
      if(d && d.checklist.length && !(s.checklist && s.checklist.length)) s.checklist = d.checklist.slice();
    });
    checklistsSeeded = true;
  }
  function setupCategory(name){
    const st = setupsList.find(x=>x.name===name);
    return st ? (st.category||'otro') : 'otro';
  }
  function setupCatLabel(name){
    const st = setupsList.find(x=>x.name===name);
    if(!st) return '—';
    const c = SETUP_CATS.find(x=>x[0]===(st.category||'otro'));
    return c ? c[1] : 'Otros';
  }
  // migración única (v4): sustituye los setups antiguos por defecto por los dos actuales y conserva los que creaste tú
  function migrateSetups(){
    const mine = setupsList.filter(st=>OLD_DEFAULT_SETUP_NAMES.indexOf(String(st.name||'').trim())<0 && !DEFAULT_SETUPS.some(d=>d.name===st.name));
    setupsList = DEFAULT_SETUPS.map(d=>Object.assign({}, d, {checklist:[...d.checklist]})).concat(mine);
    checklistsSeeded = true;
  }
  function setupPickerHTML(selected){
    if(!setupsList.length) return '<span class="sub-hint">Crea setups desde "Setups &amp; Tags" para poder asignarlos.</span>';
    return SETUP_CATS.map(([k,label])=>{
      const items = setupsList.filter(st=>(st.category||'otro')===k);
      if(!items.length) return '';
      return '<span class="grp-lbl">'+label+'</span>'+
        items.map(st=>'<span class="opt'+(selected.includes(st.name)?' sel':'')+'" data-setup="'+esc(st.name)+'">'+h(st.name)+'</span>').join('');
    }).join('');
  }
  const COLORS = ['#8b6cf1','#4f9eea','#2dd4a7','#e0b13a','#ef5b6e','#f472b6','#38bdf8'];
  // ---------- utilidades ----------
  const STORAGE_KEY = 'tradingJournal_state_v1';
  function snapshot(){
    return {rawRows, perfRows, manualTrades, multipliers, multSource, commissions, tradeMeta: metaForStorage(), rules, setupsList, setupsVersion:4, tagsList, dailyJournal, notesList, fundedCfg, groupFills, checklistsSeeded, modifiedAt};
  }
  function saveState(){
    try{
      if(!skipTouch) modifiedAt = Date.now();
      localStorage.setItem(STORAGE_KEY, JSON.stringify(snapshot()));
    }catch(err){
      toast('No se pudo guardar automáticamente (almacenamiento lleno). Exporta un JSON de respaldo desde Ajustes.');
    }
  }
  function loadState(){
    try{
      const raw = localStorage.getItem(STORAGE_KEY);
      if(!raw) return;
      const data = JSON.parse(raw);
      rawRows = data.rawRows || [];
      perfRows = data.perfRows || [];
      manualTrades = data.manualTrades || [];
      multipliers = data.multipliers || {};
      commissions = data.commissions || {};
      multSource = data.multSource || {};
      tradeMeta = data.tradeMeta || {};
      if(data.setupsList && data.setupsList.length) setupsList = normalizeSetups(data.setupsList);
      if(data.setupsVersion!==4) migrateSetups();
      if(data.tagsList && data.tagsList.length) tagsList = data.tagsList;
      dailyJournal = data.dailyJournal || {};
      notesList = data.notesList || [];
      rules = Object.assign({}, DEFAULT_RULES, data.rules || {});
      modifiedAt = Number(data.modifiedAt) || 0;
      fundedCfg = data.fundedCfg || {};
      groupFills = data.groupFills !== false;
      checklistsSeeded = !!data.checklistsSeeded;
      seedChecklists();
    }catch(err){ /* almacenamiento corrupto, se ignora */ }
  }
  function toast(msg){
    const t=document.getElementById('toast');
    t.textContent=msg; t.style.display='block';
    clearTimeout(t._h); t._h=setTimeout(()=>t.style.display='none',3000);
  }
  function fmtMoney(n){
    const s = Math.abs(n).toLocaleString('en-US',{minimumFractionDigits:2,maximumFractionDigits:2});
    return (n<0?'-$':'+$')+s;
  }
  function fmtMoneyPlain(n){ return (n<0?'-$':'$')+Math.abs(n).toLocaleString('en-US',{minimumFractionDigits:2,maximumFractionDigits:2}); }
  const C_TXT = '#c3d0e2', C_TXT2 = '#e8eef6', C_GRID = '#2a3a52';
  function fmtShort(v){
    const a = Math.abs(v); let s;
    if(a>=10000) s = Math.round(a/1000)+'k';
    else if(a>=1000) s = (a/1000).toFixed(1).replace(/\.0$/,'')+'k';
    else if(a>=10) s = String(Math.round(a));
    else s = a.toFixed(2).replace(/\.?0+$/,'');
    return (v<0?'-':'')+'$'+(s||'0');
  }
  function pad2(n){ return String(n).padStart(2,'0'); }
  function ymd(d){ return d.getFullYear()+'-'+pad2(d.getMonth()+1)+'-'+pad2(d.getDate()); }
  function parseDateInput(s){ const q = String(s).split('-').map(Number); return new Date(q[0], q[1]-1, q[2]).getTime(); }
  // intervalo de confianza de Wilson (95%) para un porcentaje de aciertos
  function wilson(w, n){
    if(!n) return null;
    const z = 1.96, pr = w/n, d = 1+z*z/n, c = pr+z*z/(2*n), m = z*Math.sqrt(pr*(1-pr)/n + z*z/(4*n*n));
    return [Math.max(0,(c-m)/d)*100, Math.min(1,(c+m)/d)*100];
  }
