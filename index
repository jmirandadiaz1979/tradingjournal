  td.sub-hint, .sub-hint td{color:var(--text-faint);}
  .page-sub{color:var(--text-dim);}
  .panel h3{color:var(--text-dim);}
  .card .label{color:var(--text-dim);}
  .card .sub{color:var(--text-dim);}
  .brand small{color:var(--text-dim);}
  .nav-item{color:var(--text-dim);}
  .nav-item:hover{color:#fff;}
  .nav-item.active{color:#fff;}
  .side-actions button,.side-actions .file-btn{color:var(--text);border-color:#34465f;}
  .side-actions .sub-hint{color:var(--text-dim);}
  .cal-day-label{color:var(--text-dim);font-weight:600;}
  .cal-cell .d{color:var(--text-dim);}
