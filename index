          '<div class="fc-top" style="margin:5px 0 0;"><span>Mejor día: <b>'+fmtMoneyPlain(s.best)+'</b>'+(s.needProfit ? ' · necesitas <b>'+fmtMoneyPlain(s.needProfit)+'</b> de beneficio total para cumplirla' : '')+'</span></div></div>';
