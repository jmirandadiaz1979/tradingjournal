    // P&L por mes
    const byMonth = {};
    trades.forEach(t=>{ const k=monthKey(t.closeTime); byMonth[k]=byMonth[k]||{value:0,count:0}; byMonth[k].value+=t.pnl; byMonth[k].count++; });
    const monthKeys = Object.keys(byMonth).sort();
    barChart(document.getElementById('monthChart'), monthKeys.map(k=>({
      label: monthLabel(k).split(' ')[0]+' '+monthLabel(k).split(' ')[1].slice(2),
      tooltipLabel: monthLabel(k), value: byMonth[k].value, count: byMonth[k].count
    })), {h:200});
    // ganadoras vs perdedoras (donut)
    const winsCount = trades.filter(t=>t.pnl>0).length, lossesCount = trades.filter(t=>t.pnl<0).length, flatCount = trades.filter(t=>t.pnl===0).length;
    donutChart(document.getElementById('winLossChart'), [
      {label:'Ganadoras', value:winsCount, color:'#2dd4a7'},
      {label:'Perdedoras', value:lossesCount, color:'#ef5b6e'},
      {label:'Breakeven', value:flatCount, color:'#5c6b80'}
    ].filter(s=>s.value>0));
    document.getElementById('winLossLegend').innerHTML =
      '<span><span class="dot" style="background:#2dd4a7;"></span>Ganadoras '+winsCount+'</span>'+
      '<span><span class="dot" style="background:#ef5b6e;"></span>Perdedoras '+lossesCount+'</span>'+
      (flatCount?'<span><span class="dot" style="background:#5c6b80;"></span>Breakeven '+flatCount+'</span>':'');
    // por setup (una operación con varias confluencias cuenta en las estadísticas de cada setup que la compone)
    const setupGroups={};
    trades.forEach(t=>{ (t.setups||[]).forEach(s=>{ (setupGroups[s]=setupGroups[s]||[]).push(t); }); });
    const setupRows = Object.entries(setupGroups).map(([name,list])=>{
      const m=computeMetrics(list);
      return '<tr><td>'+h(name)+'</td><td>'+h(setupCatLabel(name))+'</td>'+nCell(m.n)+wrCell(m)+
        '<td class="'+(m.netPnl>=0?'pos':'neg')+'">'+fmtMoney(m.netPnl)+'</td>'+
        '<td class="'+(m.expectancy>=0?'pos':'neg')+'">'+fmtMoney(m.expectancy)+'</td>'+
        '<td>'+(m.profitFactor===Infinity?'∞':m.profitFactor.toFixed(2))+'</td></tr>';
    }).join('');
    document.querySelector('#setupStatsTable tbody').innerHTML = setupRows || '<tr><td colspan="7" class="sub-hint">Sin operaciones con setup asignado todavía.</td></tr>';
    // combinaciones zona + confirmación
    const comboGroups={};
    trades.forEach(t=>{
