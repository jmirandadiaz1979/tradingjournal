  .gauge .g-val small{font-size:13px;font-weight:500;color:var(--text-faint);}
  .gauge .g-bar{height:6px;border-radius:4px;background:#1a2538;overflow:hidden;}
  .gauge .g-fill{height:100%;border-radius:4px;background:var(--green);}
