    const n=axes.length;
    function pt(i,val){ // val 0-100
      const ang = -Math.PI/2 + i*(2*Math.PI/n);
      const r = R*(val/100);
      return [cx+r*Math.cos(ang), cy+r*Math.sin(ang)];
    }
    let rings='';
    [0.25,0.5,0.75,1].forEach(f=>{
      let pts=[]; for(let i=0;i<n;i++){ const ang=-Math.PI/2+i*(2*Math.PI/n); pts.push((cx+R*f*Math.cos(ang))+','+(cy+R*f*Math.sin(ang))); }
      rings += '<polygon points="'+pts.join(' ')+'" fill="none" stroke="#2a3a52" stroke-width="1"/>';
    });
    let axisLines='', labels='';
    axes.forEach((a,i)=>{
      const ang=-Math.PI/2+i*(2*Math.PI/n);
      const ex=cx+R*Math.cos(ang), ey=cy+R*Math.sin(ang);
      axisLines += '<line x1="'+cx+'" y1="'+cy+'" x2="'+ex+'" y2="'+ey+'" stroke="#2a3a52"/>';
