    if(!_tzFmt) _tzFmt = new Intl.DateTimeFormat('en-US',{timeZone:'America/New_York', hour:'2-digit', minute:'2-digit', weekday:'short', hourCycle:'h23'});
    const o = {}; _tzFmt.formatToParts(new Date(ms)).forEach(function(x){ o[x.type] = x.value; });
