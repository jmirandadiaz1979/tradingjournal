        '<td class="'+pnlCls(t.pnl)+'">'+fmtMoney(t.pnl)+'</td><td>'+((t.setups||[]).map(function(s){ return '<span class="setup-chip cat-'+setupCategory(s)+'">'+h(s)+'</span>'; }).join(' ')||'—')+'</td>'+
