  // ---------- reglas ----------
  function sessionIndex(ms){
    const d = new Date(ms), hr = d.getHours() + d.getMinutes()/60;
    if(hr >= rules.s1Start && hr < rules.s1End) return 0;
    if(hr >= rules.s2Start && hr < rules.s2End) return 1;
    return -1;
  }
  function ruleLabel(k){
    if(k==='horario') return 'Solo operar '+hh(rules.s1Start)+'–'+hh(rules.s1End)+' y '+hh(rules.s2Start)+'–'+hh(rules.s2End);
    if(k==='maxOps') return 'Máx. '+rules.maxOps+' operaciones/día';
    if(k==='maxSL') return 'Máx. '+rules.maxSL+' SL (pérdidas)/día';
    return 'Pérdida máx. diaria '+rules.maxLoss+'$';
  }
  function ruleChip(k){
    if(k==='horario') return 'Horario';
    if(k==='maxOps') return '>'+rules.maxOps+' ops';
    if(k==='maxSL') return '>'+rules.maxSL+' SL';
    return 'Límite '+rules.maxLoss+'$';
  }
  const RULE_KEYS = ['horario','maxOps','maxSL','maxLoss'];

  function evaluateRules(trades){
    const sorted = [...trades].sort(function(a,b){ return a.openTime-b.openTime; });
    const map = {};
    sorted.forEach(function(t){
      const k = dayKey(t.closeTime);
      (map[k] = map[k] || {key:k, date:t.closeTime, trades:[]}).trades.push(t);
    });
    const days = Object.values(map).sort(function(a,b){ return a.date-b.date; });
    days.forEach(function(d){
      let cum=0, losses=0, sls=0, streak=0, minCum=0;
      d.viol = {horario:false, maxOps:false, maxSL:false, maxLoss:false};
      d.trades.forEach(function(t,i){
        const r = [];
        if(sessionIndex(t.openTime)<0) r.push('horario');
        if(i>=rules.maxOps) r.push('maxOps');
        if(sls>=rules.maxSL) r.push('maxSL');
        if(cum<=-rules.maxLoss) r.push('maxLoss');
        t.ruleBreaks = r; t.seqInDay = i+1; t.prevLossStreak = streak;
        t.prevResult = i===0 ? 'first' : (d.trades[i-1].pnl>0 ? 'win' : (d.trades[i-1].pnl<0 ? 'loss' : 'flat'));
        r.forEach(function(k){ d.viol[k]=true; });
        cum += t.pnl; minCum = Math.min(minCum, cum);
        if(t.pnl<0){ losses++; streak++; } else if(t.pnl>0){ streak=0; }
        if(isSL(t)) sls++;
      });
      if(minCum < -rules.maxLoss) d.viol.maxLoss = true;
      d.pnl = cum; d.losses = losses; d.sl = sls;
      d.clean = !(d.viol.horario || d.viol.maxOps || d.viol.maxSL || d.viol.maxLoss);
    });
    return {days:days, trades:sorted};
  }

