  // =====================================================================
  //  MEJORAS: panel Hoy, checklist, tipo de salida, calidad de datos,
  //  comisiones, comparativa mensual, ventana horaria y sincronización segura
  // =====================================================================
  function isSL(t){ return t.exitType ? t.exitType==='SL' : t.pnl<0; }
  function lvl(v, lim){ if(!lim) return 0; const r = v/lim; return r>=1 ? 2 : (r>=0.5 ? 1 : 0); }
  const LVL_CLS = ['st-ok','st-warn','st-stop'];
  const LVL_TXT = ['Dentro de reglas','Atención','Stop'];

  // ---------- panel "Hoy" con semáforo ----------
  function renderToday(trades){
    const el = document.getElementById('todayPanel'); if(!el) return;
    const now = new Date(), key = dayKey(now.getTime());
    const todays = trades.filter(function(t){ return dayKey(t.closeTime)===key; }).sort(function(a,b){ return a.closeTime-b.closeTime; });
    const ops = todays.length, sl = todays.filter(isSL).length;
    let cum = 0, worst = 0;
    todays.forEach(function(t){ cum += t.pnl; worst = Math.min(worst, cum); });
    const lossUsed = -worst;
    const lOps = lvl(ops, rules.maxOps), lSL = lvl(sl, rules.maxSL), lLoss = lvl(lossUsed, rules.maxLoss);
    const dEval = ruleEval && ruleEval.days.find(function(d){ return d.key===key; });
    const offHours = !!(dEval && dEval.viol.horario);
    let level = Math.max(lOps, lSL, lLoss);
    if(offHours) level = Math.max(level, 1);

    function gauge(label, valHtml, limTxt, used, lim, l){
      const pct = lim ? Math.min(100, Math.round(used/lim*100)) : 0;
      return '<div class="gauge lv'+l+'"><div class="g-top"><span>'+label+'</span><span>'+limTxt+'</span></div>'+
        '<div class="g-val">'+valHtml+'</div><div class="g-bar"><div class="g-fill" style="width:'+pct+'%"></div></div></div>';
    }
    const gauges =
      gauge('Operaciones', ops+'<small> / '+rules.maxOps+'</small>', 'máx. '+rules.maxOps, ops, rules.maxOps, lOps)+
      gauge('SL', sl+'<small> / '+rules.maxSL+'</small>', 'máx. '+rules.maxSL, sl, rules.maxSL, lSL)+
      gauge('P&amp;L del día', '<span class="'+pnlCls(cum)+'">'+fmtMoney(cum)+'</span>', 'límite -$'+rules.maxLoss, lossUsed, rules.maxLoss, lLoss);

    const reached = [], near = [];
    if(lOps===2) reached.push('operaciones ('+ops+'/'+rules.maxOps+')'); else if(lOps===1){ const r = rules.maxOps-ops; near.push('te '+(r===1?'queda 1 operación':'quedan '+r+' operaciones')); }
    if(lSL===2) reached.push('SL ('+sl+'/'+rules.maxSL+')'); else if(lSL===1){ const r = rules.maxSL-sl; near.push('te '+(r===1?'queda 1 SL':'quedan '+r+' SL')); }
    if(lLoss===2) reached.push('pérdida diaria (-$'+Math.round(lossUsed)+' de -$'+rules.maxLoss+')'); else if(lLoss===1) near.push('llevas el '+Math.round(lossUsed/rules.maxLoss*100)+'% de la pérdida diaria');
    if(offHours) near.push('has abierto una operación fuera de horario');
    let msg;
    if(level===2) msg = 'Stop. Has llegado al límite de '+reached.join(' y ')+'. No abras más operaciones hoy.';
    else if(level===1) msg = 'Atención: '+near.join(' · ')+'.';
    else msg = ops ? 'Todo dentro de tus reglas.' : 'Sin operaciones hoy. Límites: '+rules.maxOps+' ops · '+rules.maxSL+' SL · -$'+rules.maxLoss+'.';

    const si = sessionIndex(now.getTime());
    const sessTxt = si>=0
      ? 'Ahora estás dentro de tu sesión '+(si+1)+' ('+hh(si===0?rules.s1Start:rules.s2Start)+'–'+hh(si===0?rules.s1End:rules.s2End)+' h).'
      : 'Ahora estás fuera de tus sesiones ('+hh(rules.s1Start)+'–'+hh(rules.s1End)+' y '+hh(rules.s2Start)+'–'+hh(rules.s2End)+' h).';
    const accSel = document.getElementById('accountFilter').value;
    const cls = LVL_CLS[level];
    el.className = 'panel today '+cls;
    el.innerHTML =
      '<div class="today-head"><div><h3 style="margin:0 0 2px;">Hoy</h3><div class="sub-hint" style="margin:0;">'+
        h(now.toLocaleDateString('es-ES',{weekday:'long',day:'numeric',month:'long'}))+(accSel?' · cuenta '+h(accSel):'')+'</div></div>'+
        '<span class="light '+cls+'"><i></i>'+LVL_TXT[level]+'</span></div>'+
      '<div class="gauges">'+gauges+'</div>'+
      '<div class="today-msg '+cls+'">'+h(msg)+'</div>'+
      '<div class="today-foot">'+h(sessTxt)+'</div>';
    if(lastTodayLevel!==null && level===2 && lastTodayLevel<2) toast('Stop: has llegado al límite diario. No abras más operaciones hoy.');
    lastTodayLevel = level;
  }
  setInterval(function(){
    const c = document.getElementById('content');
