                '<text x="'+lx+'" y="'+(ly+14)+'" fill="#ffffff" font-size="12" font-weight="700" text-anchor="middle">'+(a.value==null?'—':Math.round(a.value))+'</text>';
    });
    const poly = axes.map((a,i)=>pt(i,a.value==null?0:a.value).join(',')).join(' ');
    const vertexHits = axes.map((a,i)=>{
      const [px,py] = pt(i,a.value==null?0:a.value);
      const ttHtml = '<b>'+esc(a.label)+'</b><br>'+(a.value==null?'Sin datos todavía':Math.round(a.value)+' / 100');
      return '<circle class="chart-hit" data-tt="'+esc(ttHtml)+'" cx="'+px+'" cy="'+py+'" r="8" fill="transparent" style="cursor:pointer;"/>';
    }).join('');
    svgEl.setAttribute('viewBox','0 0 '+W+' '+H);
