  // ---------- CSV parser ----------
  function parseCSV(text){
    const rows=[]; let row=[]; let field=''; let inQuotes=false;
    for(let i=0;i<text.length;i++){
      const c=text[i];
      if(inQuotes){
        if(c==='"'){ if(text[i+1]==='"'){ field+='"'; i++; } else { inQuotes=false; } }
        else field+=c;
      } else {
        if(c==='"') inQuotes=true;
        else if(c===','){ row.push(field); field=''; }
        else if(c==='\r'){ }
        else if(c==='\n'){ row.push(field); rows.push(row); row=[]; field=''; }
        else field+=c;
      }
    }
    if(field.length || row.length){ row.push(field); rows.push(row); }
    if(!rows.length) return [];
    const headers = rows[0].map(h=>h.trim());
    return rows.slice(1).filter(r=>r.length>1 && r.some(v=>v!=='')).map(r=>{
      const obj={}; headers.forEach((h,i)=> obj[h]=r[i]!==undefined?r[i].trim():''); return obj;
    });
  }
  function mergeRows(newRows){
    const existingIds = new Set(rawRows.map(r=>r['orderId']||r['Order ID']));
    let added=0, skipped=0;
    newRows.forEach(r=>{
      const id = r['orderId']||r['Order ID'];
      if(id && existingIds.has(id)){ skipped++; return; }
      if(id) existingIds.add(id);
      rawRows.push(r); added++;
    });
    return {added, skipped};
  }
  function mergePerfRows(newRows, account){
    const keyOf = r => (r['Account']||'')+'|'+r['symbol']+'|'+r['buyFillId']+'|'+r['sellFillId'];
    const existingKeys = new Set(perfRows.map(keyOf));
    let added=0, skipped=0;
    newRows.forEach(r=>{
      r['Account'] = account;
      const key = keyOf(r);
      if(existingKeys.has(key)){ skipped++; return; }
      existingKeys.add(key);
      perfRows.push(r); added++;
    });
    return {added, skipped};
  }
  function detectMultipliers(filledRows){
    const samples={};
    filledRows.forEach(r=>{
      const product = r['Product'];
      const price = num(r['Avg Fill Price']) || num(r['avgPrice']);
      const qty = num(r['Filled Qty']) || num(r['filledQty']);
      const notional = num(r['Notional Value']);
      if(!product || !price || !qty || !notional) return;
      const mult = notional/(price*qty);
      if(mult>0 && isFinite(mult)) (samples[product]=samples[product]||[]).push(mult);
    });
    const result={}, source={};
    Object.keys(samples).forEach(p=>{
      const vals=samples[p].sort((a,b)=>a-b);
      result[p]=Math.round(vals[Math.floor(vals.length/2)]*10000)/10000;
      source[p]='detected';
    });
    filledRows.forEach(r=>{
      const product=r['Product'];
      if(product && !result[product] && DEFAULT_MULTIPLIERS[product]!=null){
        result[product]=DEFAULT_MULTIPLIERS[product]; source[product]='fallback';
      }
    });
    return {result, source};
  }
  // ---------- reconstrucción FIFO ----------
  function buildTrades(filledRows, mults){
    const execs = filledRows.map(r=>({
      account: r['Account'], contract: r['Contract'], product: r['Product'],
      side: r['B/S'].trim(),
      qty: num(r['Filled Qty']) || num(r['filledQty']),
      price: num(r['Avg Fill Price']) || num(r['avgPrice']),
      time: parseFillTime(r['Fill Time'])
    })).filter(e=>e.qty>0 && !isNaN(e.price) && !isNaN(e.time));
    const groups={};
    execs.forEach(e=>{ const k=e.account+'|'+e.contract; (groups[k]=groups[k]||[]).push(e); });
    const trades=[]; const openPos=[];
    Object.values(groups).forEach(list=>{
      list.sort((a,b)=>a.time-b.time);
      let position=0; let lots=[]; let cur=null;
      function newTrade(side, e){
        return { account:e.account, contract:e.contract, product:e.product,
          side: side>0?'Long':'Short', openTime:e.time, closeTime:null, entries:[], exits:[], pnlPoints:0 };
      }
      list.forEach(e=>{
        const signed = e.side==='Buy' ? e.qty : -e.qty;
        let remaining = e.qty;
        if(position===0){
          cur = newTrade(signed, e); lots=[{price:e.price, qty:e.qty}];
          cur.entries.push({price:e.price, qty:e.qty, time:e.time}); position = signed; return;
        }
        const sameDir = Math.sign(position)===Math.sign(signed);
        if(sameDir){
          lots.push({price:e.price, qty:e.qty});
          cur.entries.push({price:e.price, qty:e.qty, time:e.time}); position += signed; return;
        }
        let closingQty = Math.min(Math.abs(position), remaining);
        cur.exits.push({price:e.price, qty:closingQty, time:e.time});
        const closeSign = position>0 ? 1 : -1;
        let toMatch = closingQty;
        while(toMatch>0 && lots.length){
          const lot=lots[0]; const m=Math.min(lot.qty, toMatch);
          cur.pnlPoints += (e.price - lot.price) * m * closeSign;
          lot.qty -= m; toMatch -= m; if(lot.qty<=0) lots.shift();
        }
        position -= closeSign*closingQty; remaining -= closingQty;
        if(position===0){
          cur.closeTime = e.time; trades.push(cur); cur=null;
          if(remaining>0){
            const newSigned = e.side==='Buy' ? remaining : -remaining;
            cur = newTrade(newSigned, e); lots=[{price:e.price, qty:remaining}];
            cur.entries.push({price:e.price, qty:remaining, time:e.time}); position = newSigned;
          }
        }
      });
      if(cur){
        const totalQty = cur.entries.reduce((s,x)=>s+x.qty,0);
        const wAvg = cur.entries.reduce((s,x)=>s+x.price*x.qty,0)/totalQty;
        openPos.push({ account:cur.account, contract:cur.contract, side:cur.side,
          qty: lots.reduce((s,l)=>s+l.qty,0), entryAvg:wAvg, since:cur.openTime });
      }
    });
    trades.forEach(t=>{
      const mult = mults[t.product] || 0;
      t.pnl = t.pnlPoints*mult;
      const eQty = t.entries.reduce((s,x)=>s+x.qty,0);
      const xQty = t.exits.reduce((s,x)=>s+x.qty,0);
      t.qty = eQty;
      t.entryAvg = t.entries.reduce((s,x)=>s+x.price*x.qty,0)/eQty;
      t.exitAvg = xQty ? t.exits.reduce((s,x)=>s+x.price*x.qty,0)/xQty : null;
      t.durationMs = t.closeTime - t.openTime;
      t.id = t.account+'|'+t.contract+'|'+t.closeTime;
      applyCommission(t);
      attachMeta(t);
    });
    return {trades, openPos};
  }
  // ---------- construcción de trades desde Performance.csv (P&L real de Tradovate, sin reconstrucción) ----------
  function buildTradesFromPerformance(rows){
    const parsed = [];
    rows.forEach(function(r){
      const boughtMs = parseFillTime(r['boughtTimestamp']);
      const soldMs = parseFillTime(r['soldTimestamp']);
      const pnl = parseMoney(r['pnl']);
      let qty = num(r['qty']);
      if(isNaN(boughtMs) || isNaN(soldMs) || isNaN(pnl)) return;
      if(isNaN(qty) || qty<=0) qty = 1;
      const side = boughtMs <= soldMs ? 'Long' : 'Short'; // compró antes de vender -> Long; vendió antes de comprar -> Short
      parsed.push({
        r:r, side:side, pnl:pnl, qty:qty, buyPrice:num(r['buyPrice']), sellPrice:num(r['sellPrice']),
        open:Math.min(boughtMs, soldMs), close:Math.max(boughtMs, soldMs),
        id:'perf|'+(r['Account']||'')+'|'+r['symbol']+'|'+r['buyFillId']+'|'+r['sellFillId']
      });
    });
    function make(members){
      members.sort(function(a,b){ return (a.open-b.open) || (a.id<b.id?-1:(a.id>b.id?1:0)); });
      const f = members[0], r = f.r;
      let qty = 0, w = {entry:0, exit:0};
      members.forEach(function(m){
        qty += m.qty;
        w.entry += (f.side==='Long' ? m.buyPrice : m.sellPrice) * m.qty;
        w.exit += (f.side==='Long' ? m.sellPrice : m.buyPrice) * m.qty;
      });
      const openTime = Math.min.apply(null, members.map(function(m){ return m.open; }));
      const closeTime = Math.max.apply(null, members.map(function(m){ return m.close; }));
      const t = {
        account: r['Account'] || 'Sin cuenta',
        contract: r['symbol'], product: productFromSymbol(r['symbol']),
        side:f.side, openTime:openTime, closeTime:closeTime, qty:qty,
        entryAvg: w.entry/qty, exitAvg: w.exit/qty,
        pnl: members.reduce(function(s,m){ return s+m.pnl; },0),
        durationMs: closeTime-openTime, fills: members.length,
        id: f.id
      };
      if(members.length>1) t.altIds = members.slice(1).map(function(m){ return m.id; });
      applyCommission(t);
      attachMeta(t);
      return t;
    }
    if(!groupFills) return parsed.map(function(m){ return make([m]); });
    // unión de filas de la misma posición: comparten una ejecución o sus intervalos se solapan (misma cuenta, símbolo y lado)
    const parent = parsed.map(function(_, i){ return i; });
    const find = function(i){ while(parent[i]!==i){ parent[i] = parent[parent[i]]; i = parent[i]; } return i; };
    const union = function(a, b){ const x = find(a), y = find(b); if(x!==y) parent[y] = x; };
    const seen = {};
    parsed.forEach(function(m, i){
      const base = (m.r['Account']||'')+'|'+m.r['symbol']+'|'+m.side;
      [['B', m.r['buyFillId']], ['S', m.r['sellFillId']]].forEach(function(pair){
        if(pair[1]==null || pair[1]==='') return;
        const k = base+'|'+pair[0]+pair[1];
        if(k in seen) union(seen[k], i); else seen[k] = i;
      });
    });
    const byKey = {};
    parsed.forEach(function(m, i){ const k = (m.r['Account']||'')+'|'+m.r['symbol']+'|'+m.side; (byKey[k] = byKey[k] || []).push(i); });
    Object.keys(byKey).forEach(function(k){
      const idx = byKey[k].slice().sort(function(a,b){ return parsed[a].open-parsed[b].open; });
      let maxClose = -Infinity, prev = -1;
      idx.forEach(function(i){
        if(prev>=0 && parsed[i].open < maxClose) union(prev, i);
        maxClose = Math.max(maxClose, parsed[i].close); prev = i;
      });
    });
    const comps = {};
    parsed.forEach(function(m, i){ const root = find(i); (comps[root] = comps[root] || []).push(m); });
    return Object.keys(comps).map(function(root){ return make(comps[root]); });
  }
  // ---------- operaciones añadidas manualmente ----------
  function buildManualTrades(){
