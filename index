    if(psy.length) lines.push('Psicología (media de '+psy.length+' registros): disciplina '+avgDisc.toFixed(1)+'/10, energía '+avgEn.toFixed(1)+'/10.');
    lines.push(viol[0].days ? 'Foco para la próxima semana: '+ruleLabel(viol[0].k)+'.' : 'Foco para la próxima semana: mantener el proceso, sin reglas rotas.');
