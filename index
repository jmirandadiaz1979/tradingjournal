    const fmtV = v => isR ? ((v>=0?'+':'')+v.toFixed(2)+'R') : fmtMoney(v);
    const axV = v => isR ? ((v>=0?'+':'')+(Math.abs(v)>=10?v.toFixed(0):v.toFixed(1))+'R') : fmtShort(v);
    const palette = ['#8b6cf1','#4f9eea','#2dd4a7','#e0b13a','#f472b6','#fb923c','#38bdf8'];
    const groups = multi ? accs : ['__all__'];
    const series = groups.map(function(g, gi){
      let cum = 0, peak = 0; const pts = [];
      sorted.forEach(function(t, i){
        if(multi && t.account!==g) return;
        cum += valOf(t); peak = Math.max(peak, cum);
        pts.push({i:i, y:cum, dd:cum-peak, t:t});
      });
      return {name:(g==='__all__'?'Total':g), color:(multi ? palette[gi%palette.length] : (cum>=0?'#2dd4a7':'#ef5b6e')), pts:pts};
    });
    const allY = [], allDD = [];
    series.forEach(s=>s.pts.forEach(p=>{ allY.push(p.y); allDD.push(p.dd); }));
    const minY = Math.min(0, ...allY), maxY = Math.max(0, ...allY), range = (maxY-minY)||1;
    const ddMin = Math.min(0, ...allDD), ddRange = (0-ddMin)||1;
    const x = i => padL + (n>1 ? i/(n-1) : .5)*(W-padL-padR);
    const y = v => mainBottom - ((v-minY)/range)*(mainBottom-padT);
    const ddTop = mainBottom+gap, ddBottom = H-padB;
    const yd = v => ddTop + ((0-v)/ddRange)*(ddBottom-ddTop);
    let grid = '';
    for(let k=0;k<=3;k++){
      const v = minY + range*k/3;
      grid += '<line x1="'+padL+'" y1="'+y(v)+'" x2="'+(W-padR)+'" y2="'+y(v)+'" stroke="'+C_GRID+'" stroke-width="1"/>'+
        '<text x="'+(padL-8)+'" y="'+(y(v)+4)+'" fill="'+C_TXT+'" font-size="10.5" text-anchor="end">'+axV(v)+'</text>';
    }
    // eje X con fechas
    let xt = '';
    const tickIdx = []; for(let k=0;k<=4;k++){ const ix = Math.round(k*(n-1)/4); if(tickIdx.indexOf(ix)<0) tickIdx.push(ix); }
    tickIdx.forEach(function(ix, k){
      const d = new Date(sorted[ix].closeTime), lbl = d.toLocaleDateString('es-ES',{day:'2-digit',month:'short'});
      const anchor = (tickIdx.length>1 && k===0) ? 'start' : ((tickIdx.length>1 && k===tickIdx.length-1) ? 'end' : 'middle');
      xt += '<line x1="'+x(ix)+'" y1="'+padT+'" x2="'+x(ix)+'" y2="'+ddBottom+'" stroke="'+C_GRID+'" stroke-width="1" stroke-dasharray="2 5" opacity=".6"/>'+
        '<text x="'+x(ix)+'" y="'+(H-8)+'" fill="'+C_TXT+'" font-size="10.5" text-anchor="'+anchor+'">'+h(lbl)+'</text>';
    });
    let body = '', defs = '', hits = '';
    series.forEach(function(s, si){
      const pts = s.pts; if(!pts.length) return;
      const line = 'M'+pts.map(p=>x(p.i)+','+y(p.y)).join(' L');
      if(!multi){
        const gid = 'eqGrad'+si;
        defs += '<linearGradient id="'+gid+'" x1="0" y1="0" x2="0" y2="1"><stop offset="0%" stop-color="'+s.color+'" stop-opacity=".30"/><stop offset="100%" stop-color="'+s.color+'" stop-opacity="0"/></linearGradient>';
        body += '<path d="'+line+' L'+x(pts[pts.length-1].i)+','+y(0)+' L'+x(pts[0].i)+','+y(0)+' Z" fill="url(#'+gid+')" stroke="none"/>';
      }
      body += '<path d="'+line+'" fill="none" stroke="'+s.color+'" stroke-width="2.3" stroke-linejoin="round" stroke-linecap="round"/>';
      const last = pts[pts.length-1];
      body += '<circle cx="'+x(last.i)+'" cy="'+y(last.y)+'" r="3.8" fill="'+s.color+'"/>';
      const ddLine = 'M'+pts.map(p=>x(p.i)+','+yd(p.dd)).join(' L');
      if(!multi){
        body += '<path d="M'+x(pts[0].i)+','+ddTop+' L'+pts.map(p=>x(p.i)+','+yd(p.dd)).join(' L')+' L'+x(last.i)+','+ddTop+' Z" fill="rgba(239,91,110,.30)" stroke="none"/>'+
          '<path d="'+ddLine+'" fill="none" stroke="#ef5b6e" stroke-width="1.6" stroke-linejoin="round"/>';
      } else {
        body += '<path d="'+ddLine+'" fill="none" stroke="'+s.color+'" stroke-width="1.5" opacity=".85" stroke-linejoin="round"/>';
      }
      pts.forEach(function(p){
        const ttHtml = '<b>'+esc(new Date(p.t.closeTime).toLocaleString('es-ES'))+'</b><br>'+esc(p.t.account+' · '+p.t.contract+' '+p.t.side)+
          '<br>Operación: <span style="color:'+(valOf(p.t)>=0?'#2dd4a7':'#ef5b6e')+'">'+fmtV(valOf(p.t))+'</span><br>Acumulado: <b>'+fmtV(p.y)+'</b><br>Drawdown: '+fmtV(p.dd);
        hits += '<circle class="chart-hit" data-tt="'+esc(ttHtml)+'" cx="'+x(p.i)+'" cy="'+y(p.y)+'" r="7" fill="transparent" style="cursor:pointer;"/>';
      });
    });
    svg.setAttribute('viewBox','0 0 '+W+' '+H);
    svg.innerHTML = '<defs>'+defs+'</defs>'+grid+xt+
      '<line x1="'+padL+'" y1="'+y(0)+'" x2="'+(W-padR)+'" y2="'+y(0)+'" stroke="#4a5d7a" stroke-width="1" stroke-dasharray="4 4"/>'+
      '<text x="'+padL+'" y="'+(ddTop-3)+'" fill="'+C_TXT+'" font-size="10.5" font-weight="600">DRAWDOWN</text>'+
      '<line x1="'+padL+'" y1="'+ddTop+'" x2="'+(W-padR)+'" y2="'+ddTop+'" stroke="#4a5d7a" stroke-width="1"/>'+
      '<text x="'+(padL-8)+'" y="'+(ddTop+4)+'" fill="'+C_TXT+'" font-size="10.5" text-anchor="end">0</text>'+
      '<text x="'+(padL-8)+'" y="'+(ddBottom+4)+'" fill="'+C_TXT+'" font-size="10.5" text-anchor="end">'+axV(ddMin)+'</text>'+
      body+hits;
    attachChartTooltips(svg);
    legend.innerHTML = series.map(function(s){
      const last = s.pts[s.pts.length-1], mdd = Math.min.apply(null, s.pts.map(p=>p.dd));
      return '<span><span class="dot" style="background:'+s.color+';"></span>'+(multi?h(s.name)+' · ':'')+'Acumulado <b>'+fmtV(last.y)+'</b> · DD máx. <b>'+fmtV(mdd)+'</b> · DD actual <b>'+fmtV(last.dd)+'</b></span>';
    }).join('');
  }
