      bins.push({label:'≥5R', tip:'5R o más', from:5, to:Infinity});
      const hist = bins.map(b=>{ const cnt = withR.filter(t=>t.rMultiple>=b.from && t.rMultiple<b.to).length; return {label:b.label, tooltipLabel:b.tip, value:cnt, count:cnt, pos:b.from>=0}; });
      barChart(document.getElementById('rHistChart'), hist, {h:160, bottom:true, noCount:true, fmt:v=>v+(v===1?' operación':' operaciones'), axisFmt:v=>String(Math.round(v)), zeroLabel:'0', colorFn:d=>d.pos?'#2dd4a7':'#ef5b6e'});
    }
    // métricas avanzadas
    const m = computeMetrics(trades);
    const advWrap = document.getElementById('advancedMetrics');
    if(!m){
      advWrap.innerHTML = '<div class="sub-hint">Sin operaciones todavía.</div>';
    } else {
      const recoveryFactor = m.maxDD>0 ? (m.netPnl/m.maxDD) : null;
      const payoffRatio = m.avgLoss>0 ? (m.avgWin/m.avgLoss) : null;
      const dayPnl = {}; trades.forEach(t=>{ const k=dayKey(t.closeTime); dayPnl[k]=(dayPnl[k]||0)+t.pnl; });
      const dayVals = Object.keys(dayPnl).map(k=>dayPnl[k]);
      const tradedDays = dayVals.length;
      const tradesPerDay = tradedDays ? (trades.length/tradedDays) : 0;
      const monthEntries = Object.entries(byMonth).map(([k,v])=>[k,v.value]);
      const bestMonth = monthEntries.length ? monthEntries.reduce((a,b)=>b[1]>a[1]?b:a) : null;
      const worstMonth = monthEntries.length ? monthEntries.reduce((a,b)=>b[1]<a[1]?b:a) : null;
      const mean = a=>a.reduce((s,v)=>s+v,0)/a.length;
      const sd = a=>{ if(a.length<2) return 0; const mu = mean(a); return Math.sqrt(a.reduce((s,v)=>s+(v-mu)*(v-mu),0)/(a.length-1)); };
      let sharpe = null, sortino = null;
      if(dayVals.length>=5){
        const mu = mean(dayVals), s = sd(dayVals);
        if(s>0) sharpe = mu/s*Math.sqrt(252);
        const dd = Math.sqrt(dayVals.reduce((a,v)=>a+Math.min(0,v)*Math.min(0,v),0)/dayVals.length);
        if(dd>0) sortino = mu/dd*Math.sqrt(252);
      }
      const rArr = withR.map(t=>t.rMultiple), sqnIsR = rArr.length>=10;
      const sqnSrc = sqnIsR ? rArr : trades.map(t=>t.pnl);
      let sqn = null;
      if(sqnSrc.length>=10){ const s = sd(sqnSrc); if(s>0) sqn = Math.sqrt(Math.min(sqnSrc.length,100))*mean(sqnSrc)/s; }
      const sqnTxt = v => v==null ? '' : (v<1.6?'pobre':(v<2?'bajo':(v<2.5?'medio':(v<3?'bueno':(v<5?'excelente':'excepcional')))));
      const winsL = trades.filter(t=>t.pnl>0), lossL = trades.filter(t=>t.pnl<0);
      const bigWin = winsL.length ? Math.max.apply(null, winsL.map(t=>t.pnl)) : null;
      const bigLoss = lossL.length ? Math.min.apply(null, lossL.map(t=>t.pnl)) : null;
      const avgDur = l => l.length ? l.reduce((s,t)=>s+t.durationMs,0)/l.length : null;
      const ci = wilson(m.wins, m.n), rm2 = computeRMetrics(trades);
      advWrap.innerHTML = [
        card('RECOVERY FACTOR', recoveryFactor!=null?recoveryFactor.toFixed(2):'—', recoveryFactor!=null&&recoveryFactor>=1?'pos':'', 'Net P&amp;L / Max Drawdown'),
        card('PAYOFF RATIO', payoffRatio!=null?payoffRatio.toFixed(2):'—', payoffRatio!=null&&payoffRatio>=1?'pos':'', 'Avg Win / Avg Loss'),
        card('EXPECTANCY EN R', rm2?fmtR(rm2.avgR):'—', rm2?(rm2.avgR>=0?'pos':'neg'):'', rm2?rm2.n+' ops con riesgo inicial':'Asigna riesgo inicial a tus operaciones'),
        card('SQN', sqn!=null?sqn.toFixed(2):'—', sqn!=null?(sqn>=2?'pos':(sqn<1.6?'neg':'')):'', sqn!=null ? (sqnIsR?'en R':'en $ (con R sería más fiable)')+' · '+sqnTxt(sqn) : 'Necesitas al menos 10 operaciones'),
        card('SHARPE DIARIO', sharpe!=null?sharpe.toFixed(2):'—', sharpe!=null?(sharpe>=1?'pos':(sharpe<0?'neg':'')):'', sharpe!=null ? 'anualizado (√252) · '+tradedDays+' días' : 'Necesitas al menos 5 días operados'),
        card('SORTINO DIARIO', sortino!=null?sortino.toFixed(2):'—', sortino!=null?(sortino>=1?'pos':(sortino<0?'neg':'')):'', sortino!=null ? 'solo penaliza los días negativos' : 'Necesitas al menos 5 días y alguno negativo'),
        card('MAYOR GANANCIA', bigWin!=null?fmtMoney(bigWin):'—', 'pos', bigWin!=null && m.grossProfit>0 ? Math.round(bigWin/m.grossProfit*100)+'% del beneficio bruto' : ''),
        card('MAYOR PÉRDIDA', bigLoss!=null?fmtMoney(bigLoss):'—', 'neg', bigLoss!=null && m.grossLoss>0 ? Math.round(Math.abs(bigLoss)/m.grossLoss*100)+'% de la pérdida bruta' : ''),
        card('DURACIÓN GANADORAS / PERDEDORAS', fmtDur(avgDur(winsL))+' / '+fmtDur(avgDur(lossL)), 'sm14', 'Si pierdes más tiempo en las perdedoras, estás dejando correr pérdidas'),
        card('WIN RATE · IC 95%', ci ? ci[0].toFixed(0)+'–'+ci[1].toFixed(0)+'%' : '—', '', 'rango razonable con '+m.n+' operaciones'+(m.n<30?' (muestra pequeña)':'')),
        card('OPERACIONES / DÍA', tradesPerDay.toFixed(1), '', tradedDays+' días operados'),
        card('MEJOR MES', bestMonth?monthLabel(bestMonth[0]):'—', bestMonth&&bestMonth[1]>=0?'pos':'neg', bestMonth?fmtMoney(bestMonth[1]):''),
        card('PEOR MES', worstMonth?monthLabel(worstMonth[0]):'—', worstMonth&&worstMonth[1]<0?'neg':'pos', worstMonth?fmtMoney(worstMonth[1]):'')
      ].join('');
    }
    renderDistribution(trades);
    renderProjection(trades);
  }
  // ---------- distribución del P&L y concentración ----------
  function renderDistribution(trades){
    const hist = document.getElementById('pnlHistChart'), seq = document.getElementById('pnlSeqChart'), conc = document.getElementById('concStats'), hint = document.getElementById('pnlSeqHint');
    if(!trades.length){ hist.innerHTML=''; seq.innerHTML=''; conc.innerHTML=''; return; }
    const vals = trades.map(t=>t.pnl);
    const mn = Math.min.apply(null, vals), mx = Math.max.apply(null, vals);
    const rawStep = ((mx-mn)||1)/10, pw = Math.pow(10, Math.floor(Math.log10(rawStep)));
    let step = pw*10; [1,2,2.5,5,10].some(function(s){ if(s*pw>=rawStep){ step = s*pw; return true; } return false; });
    const lo = Math.floor(mn/step)*step, hi = (Math.ceil(mx/step)*step) || step;
    const nb = Math.max(1, Math.round((hi-lo)/step));
    const bins = []; for(let i=0;i<nb;i++) bins.push({a:lo+i*step, b:lo+(i+1)*step, n:0});
    vals.forEach(function(v){ let i = Math.floor((v-lo)/step+1e-9); if(i>=nb) i = nb-1; if(i<0) i = 0; bins[i].n++; });
    const every = Math.ceil(nb/8);
    barChart(hist, bins.map(function(b,i){
      return {label:(i%every===0 ? fmtShort(b.a) : ''), tooltipLabel:fmtShort(b.a)+' → '+fmtShort(b.b), value:b.n, count:b.n, pos:b.a>=-1e-9};
    }), {h:210, bottom:true, noCount:true, fmt:v=>v+(v===1?' operación':' operaciones'), axisFmt:v=>String(Math.round(v)), zeroLabel:'0', colorFn:d=>d.pos?'#2dd4a7':'#ef5b6e'});
    const sorted = [...trades].sort((a,b)=>a.closeTime-b.closeTime), cap = 120, part = sorted.slice(-cap), off = sorted.length-part.length;
    const ev = Math.max(1, Math.ceil(part.length/8));
    hint.textContent = sorted.length>cap ? 'Últimas '+cap+' de '+sorted.length+' operaciones. Comprueba si dependes de pocas operaciones grandes.' : 'Comprueba si dependes de pocas operaciones grandes.';
    barChart(seq, part.map(function(t,i){
      return {label:(i%ev===0 ? String(off+i+1) : ''), tooltipLabel:'#'+(off+i+1)+' · '+new Date(t.closeTime).toLocaleString('es-ES')+' · '+t.contract+' '+t.side, value:t.pnl};
    }), {h:190, noCount:true});
    const desc = [...vals].sort((a,b)=>b-a), gp = vals.filter(v=>v>0).reduce((s,v)=>s+v,0), net = vals.reduce((s,v)=>s+v,0);
    const top3 = desc.slice(0,3).filter(v=>v>0).reduce((s,v)=>s+v,0);
    conc.innerHTML =
      '<div class="m"><b>'+(gp>0 ? Math.round(top3/gp*100)+'%' : '—')+'</b>del beneficio bruto sale de tus 3 mejores operaciones</div>'+
      '<div class="m"><b class="'+pnlCls(net-desc[0])+'">'+fmtMoney(net-desc[0])+'</b>resultado neto sin tu mejor operación</div>';
  }

  // ---------- insights automáticos ----------
  function buildInsights(trades){
    const out = [], n = trades.length, fm = fmtMoney;
    if(n<10) return [{tone:'info', txt:'Necesitas al menos <b>10 operaciones</b> en la selección para generar insights (ahora hay '+n+').'}];
    const zone = tzMode==='ny' ? ' (hora de Nueva York)' : '';
    const byH = groupBy(trades, t=>tzParts(t.openTime).hour);
    const hrs = Object.keys(byH).map(k=>({hr:Number(k), m:computeMetrics(byH[k])})).filter(x=>x.m.n>=5).sort((a,b)=>b.m.expectancy-a.m.expectancy);
    const slot = hr => pad2(hr)+':00–'+pad2((hr+1)%24)+':00';
    if(hrs.length){
      const b = hrs[0];
      out.push({tone:b.m.expectancy>=0?'pos':'neg', txt:'Tu mejor franja de entrada es <b>'+slot(b.hr)+'</b>'+zone+': '+fm(b.m.expectancy)+' por operación en '+b.m.n+' ops.'});
      const w = hrs[hrs.length-1];
      if(hrs.length>1 && w.m.expectancy<0) out.push({tone:'neg', txt:'Tu peor franja es <b>'+slot(w.hr)+'</b>'+zone+': '+fm(w.m.expectancy)+' por operación en '+w.m.n+' ops. Plantéate no operar ahí.'});
    }
    const tg = {}; trades.forEach(t=>(t.tags||[]).forEach(g=>{ (tg[g] = tg[g] || []).push(t); }));
    const tgs = Object.keys(tg).map(k=>({name:k, m:computeMetrics(tg[k])})).filter(x=>x.m.n>=3 && x.m.netPnl<0).sort((a,b)=>a.m.netPnl-b.m.netPnl);
    if(tgs.length) out.push({tone:'neg', txt:'El error que más te cuesta es <b>'+h(tgs[0].name)+'</b>: '+fm(tgs[0].m.netPnl)+' en '+tgs[0].m.n+' operaciones.'});
    const full = trades.filter(t=>t.chkPct===100), part = trades.filter(t=>t.chkPct!=null && t.chkPct<100);
    if(full.length>=3 && part.length>=3){
      const a = computeMetrics(full), b = computeMetrics(part);
      out.push({tone:a.expectancy>=b.expectancy?'pos':'warn', txt:'Con el checklist completo ganas <b>'+fm(a.expectancy)+'</b> por operación ('+a.n+' ops); con el checklist incompleto, <b>'+fm(b.expectancy)+'</b> ('+b.n+' ops).'});
    }
    const yes = trades.filter(t=>t.planFollowed==='si'), no = trades.filter(t=>t.planFollowed==='no');
    if(yes.length>=3 && no.length>=3){
      const a = computeMetrics(yes), b = computeMetrics(no);
      out.push({tone:a.expectancy>=b.expectancy?'pos':'warn', txt:'Cuando sigues el plan: <b>'+fm(a.expectancy)+'</b> por operación ('+a.n+'); cuando no: <b>'+fm(b.expectancy)+'</b> ('+b.n+').'});
    }
    const sg = {}; trades.forEach(t=>(t.setups||[]).forEach(s=>{ (sg[s] = sg[s] || []).push(t); }));
    const sgs = Object.keys(sg).map(k=>({name:k, m:computeMetrics(sg[k])})).filter(x=>x.m.n>=5).sort((a,b)=>b.m.expectancy-a.m.expectancy);
    if(sgs.length){
      if(sgs[0].m.expectancy>0) out.push({tone:'pos', txt:'El setup que mejor te funciona es <b>'+h(sgs[0].name)+'</b>: '+fm(sgs[0].m.expectancy)+' por operación en '+sgs[0].m.n+' ops.'});
      const w = sgs[sgs.length-1];
      if(sgs.length>1 && w.m.expectancy<0) out.push({tone:'neg', txt:'El setup que peor te funciona es <b>'+h(w.name)+'</b>: '+fm(w.m.expectancy)+' por operación en '+w.m.n+' ops.'});
    }
    const eg = groupBy(trades, t=>t.emotion ? t.emotion : null);
    const egs = Object.keys(eg).map(k=>({name:k, m:computeMetrics(eg[k])})).filter(x=>x.m.n>=4 && x.m.netPnl<0).sort((a,b)=>a.m.netPnl-b.m.netPnl);
    if(egs.length) out.push({tone:'neg', txt:'Con la emoción <b>'+h(egs[0].name)+'</b> llevas '+fm(egs[0].m.netPnl)+' en '+egs[0].m.n+' operaciones.'});
    const dn = {1:'lunes',2:'martes',3:'miércoles',4:'jueves',5:'viernes',6:'sábado',0:'domingo'};
    const dg = groupBy(trades, t=>tzParts(t.openTime).dow);
    const dgs = Object.keys(dg).map(k=>({d:Number(k), m:computeMetrics(dg[k])})).filter(x=>x.m.n>=5).sort((a,b)=>b.m.expectancy-a.m.expectancy);
    if(dgs.length>1){
      const b = dgs[0], w = dgs[dgs.length-1];
      out.push({tone:'info', txt:'Tu mejor día es el <b>'+dn[b.d]+'</b> ('+fm(b.m.expectancy)+' por op, '+b.m.n+' ops) y el peor el <b>'+dn[w.d]+'</b> ('+fm(w.m.expectancy)+' por op, '+w.m.n+' ops).'});
    }
    const afterLoss = trades.filter(t=>t.prevResult==='loss'), firstOp = trades.filter(t=>t.prevResult==='first');
    if(afterLoss.length>=5 && firstOp.length>=5){
      const a = computeMetrics(afterLoss), b = computeMetrics(firstOp);
      out.push({tone:a.expectancy<b.expectancy?'warn':'pos', txt:'Tras una pérdida tu resultado medio es <b>'+fm(a.expectancy)+'</b> ('+a.n+' ops), frente a <b>'+fm(b.expectancy)+'</b> en la primera operación del día ('+b.n+' ops).'});
    }
    if(!out.length) out.push({tone:'info', txt:'Aún no hay grupos con muestra suficiente. Marca setup, emoción, plan y tags en tus operaciones para que aparezcan lecturas.'});
    return out;
  }
