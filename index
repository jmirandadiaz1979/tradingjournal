  function process(){
    const filled = rawRows.filter(r=>r['Status'] && r['Status'].trim()==='Filled');
    let ordersOpenPos = [];
    let baseTrades = [];
    if(filled.length){
      const det = detectMultipliers(filled);
      Object.keys(det.result).forEach(p=>{
        if(multSource[p]==='manual') return;
        multipliers[p]=det.result[p]; multSource[p]=det.source[p];
      });
      const builtFromOrders = buildTrades(filled, multipliers);
      ordersOpenPos = builtFromOrders.openPos;
      if(!perfRows.length){ baseTrades = builtFromOrders.trades; dataSource = 'orders'; }
    }
    if(perfRows.length){
      baseTrades = buildTradesFromPerformance(perfRows);
      dataSource = filled.length ? 'both' : 'performance';
    } else if(!filled.length){
      dataSource = 'none';
    }
    // las posiciones abiertas solo pueden verse en Orders.csv (Performance solo trae operaciones ya cerradas)
    openPositions = ordersOpenPos;
    allTrades = baseTrades.concat(buildManualTrades());
    populateAccountFilter();
    render();
    saveState();
  }
